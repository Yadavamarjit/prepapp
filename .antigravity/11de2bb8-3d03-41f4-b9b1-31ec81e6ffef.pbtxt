      thinking_signature: "\022\251\006\n\246\006\001i\024}\023R\n0\257|\202\360\337Y\327\203\335\3441S\273Z\215\203L\035\303\355\233G\210\234T(\022\303\217\245\017\034\330W\315gv\340\355\326P\2079\332_g\304\037c\223\223\355\030h\316\235\by\330\242\001\030\250f\201@\2776\vj Hr|/1\377p\302\235{h\311!\375y\230\"\341\246\346Z\270\274\216\037\004\323\237\035\254\246+n\254\035\372Gq~\202c_\033\2753U#\272&\345)\372\203\024|=\334\260\2163p\350\343R\366\317A9\343\326Sx\230\217[fwQ\247\023\247G<\377\315\314t\033\313\260g>\004\004\261|\333\002\r:-6L:\312\223\fb\261\264\201\232\022\305z%\370Lk\310N\261t\364\\\275=\355\'\006[E\265\225\222\237\317\232V4\370\000\255\250m7G\210\252\005\252&\205\310\t\360l\'g+\320\261\226(\034\215\036\314\327\235\255\220\373&\230\354\226%/:\233\305\311\302s\367\230\202<\372\\za\342E\327\366\212\370\323\'zBG\272o4q\217f\2139qs\3211\301\300\020z/t/\306I\245\2140\247qI[\001\215U\035U\351\322\262\214\310\274\253\025X*\255\f\206+$u\314D\272\302\b\254E%\fU\244\262\261\335=\372+i\261\244\256\267\340\020\016\313L\374J\301\215K\246P\330e\2617\215\037\247D\306\210+\357\266\370\321?\023;r\3332\347\213\3260\311\"P\367>A\250.\211uZ5\277:x\f\316xl9o\344\200I\323\260\3303\026l~\261w\036s0w5\235<F\025\236\025D\344\374\026Z\305K\263\333O\205\302\205\004\032U\243\244X\031\207\272\210\216\267<\316\314>:\251\257p\273\003\300d\303#\364U\211\251\n\363\266\023\220\257\261c\274*\364\353\017XX\006\250\341\020\3239\034\361\342duD\'\332\302\035\230\177\317TF\333\221f3\027\224)h]\333\031\304\376\265@Z:n\377\v\202\263\216@IT\347N\232eq\314\265\332\032D\367\221\302\307\350\212h\231\2346\024\372\330\026\216\004}\226\221.D=,\265\375\3155\210\"\262\235A&A\362\035\330l\200\364.f\303\230p\271\335\v\332\377\3331\317\274\317\'\211v\251\247s\r}\004.h&\247\342\021\261\177._W\204\267\212\340\222\tqW\273\331;\330\337e\265\277\246\267?\373.F<\326\211\356\364\220\214\333v\3309!\023%\b\217\177b\035-\0021X\263\372\036\006j\213\334\037\340\353\005\203X\302\261;A\221a\377\252\323\252\374q\315\2