            lines {
              text: "  // Check fallback match"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const lower = topic.toLowerCase();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  let fallbackKey = \'emergency\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (lower.includes(\'compound\') || lower.includes(\'interest\')) fallbackKey = \'compound_interest\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  else if (lower.includes(\'armed forces\') || lower.includes(\'33\')) fallbackKey = \'armed_forces\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  else if (lower.includes(\'1919\') || lower.includes(\'1935\') || lower.includes(\'act\')) fallbackKey = \'goi_acts\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  try {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const systemInstruction = `You are a legendary UPSC CAPF AC and SSC CPO mentor who excels at deconstructing complex military, constitutional, quantitative, and historical topics into crystal-clear, high-retention mental frameworks."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Teach in an intuitive, accessible style (\"teach very easy\") while retaining the rigorous academic depth required for UPSC CAPF Paper 1 & 2 and the speed precision required for SSC CPO.`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const prompt = `Break down the following exam topic for an aspirant preparing simultaneously for UPSC CAPF AC and SSC CPO:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Topic: \"${topic}\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Subject: \"${subject || \'General Studies\'}\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
