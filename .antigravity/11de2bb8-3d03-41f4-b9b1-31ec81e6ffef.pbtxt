    content: "export type ExamTrack = \'UPSC_CAPF\' | \'SSC_CPO\' | \'SHARED_CORE\';\n\nexport type Subject = \n  | \'Polity & Constitution\' \n  | \'Modern History\' \n  | \'Geography & Environment\' \n  | \'General Science\' \n  | \'Quantitative Aptitude\' \n  | \'Reasoning & Intelligence\' \n  | \'English Comprehension\' \n  | \'Paper 2 (Subjective)\';\n\nexport interface QuestionOption {\n  key: \'A\' | \'B\' | \'C\' | \'D\';\n  text: string;\n}\n\nexport interface QuestionExplanation {\n  coreConcept: string;\n  shortcutOrTrick?: string;\n  standardBookRef?: string;\n  trapAlert?: string;\n}\n\nexport interface Question {\n  id: string;\n  targetExam: (\'SSC_CPO\' | \'UPSC_CAPF\')[];\n  subject: Subject;\n  microTopic: string;\n  difficulty: \'Speed\' | \'Analytical\';\n  type: \'SINGLE_CHOICE\' | \'STATEMENT_BASED\';\n  questionText: string;\n  statements?: string[]; // 1, 2, 3 statements for UPSC standard format\n  options: QuestionOption[];\n  correctAnswer: \'A\' | \'B\' | \'C\' | \'D\';\n  explanation: QuestionExplanation;\n  yearRef?: string;\n}\n\nexport type MistakeReason = \'Conceptual Gap\' | \'Misread Question\' | \'Calculation/Time Panic\';\n\nexport interface MistakeRecord {\n  id: string;\n  questionId: string;\n  selectedAnswer: \'A\' | \'B\' | \'C\' | \'D\';\n  correctAnswer: \'A\' | \'B\' | \'C\' | \'D\';\n  timeSpentSeconds: number;\n  reason?: MistakeReason;\n  timestamp: number;\n  reviewCount: number;\n  nextReviewDate: number; // SRS timestamp\n  notes?: string;\n}\n\nexport type Paper2Type = \'ESSAY\' | \'ARGUMENT\' | \'REPORT\' | \'PRECIS\';\n\nexport interface Paper2Prompt {\n  id: string;\n  type: Paper2Type;\n  title: string;\n  prompt: string;\n  wordLimit: number;\n  suggestedMinutes: number;\n  originalPassage?: string; // For Pr\303\251cis writing\n  contextTags: string[];\n}\n\nexport interface Paper2Feedback {\n  totalScore: number; // out of 20 marks\n  structuralScore: number;\n  factualAndDepthScore: number;\n  toneAndGrammarScore: number;\n  objectiveToneAudit: string;\n  pointsForFeedback: string[];\n  pointsAgainstFeedback: string[];\n  pr\303\251cisRuleCompliance?: string;\n  strengths: string[];\n  suggestedImprovements: string[];\n  modelAnswerSnippet?: string;\n}\n\nexport interface Paper2Submission {\n  id: string;\n  topicType: Paper2Type;\n  promptId: string;\n  promptTitle: string;\n  content: string;\n  wordCount: number;\n  timeSpentSeconds: number;\n  submittedAt: number;\n  aiFeedback?: Paper2Feedback;\n}\n\nexport interface SyllabusSubtopic {\n  id: string;\n  title: string;\n  isShared: boolean;\n  examFocus: (\'CAPF\' | \'CPO\')[];\n  weightage: \'High\' | \'Medium\' | \'Low\';\n  standardRef: string;\n  keyConcepts: string[];\n}\n\nexport interface SyllabusModule {\n  id: string;\n  subject: Subject;\n  iconName: string;\n  description: string;\n  isSharedCore: boolean;\n  subtopics: SyllabusSubtopic[];\n}\n"
    num_lines: 112
