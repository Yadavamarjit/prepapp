              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Evaluation Rubric in CAPF Paper 2: 6 marks for Structure & Formatter adherence; 8 marks for Factual & Institutional Depth; 6 marks for Objective Administrative Tone. Never use words like \"corrupt\", \"idiotic\", or \"tyrannical\". Use \"institutional inadequacy\", \"regulatory deficit\", or \"operational friction\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
