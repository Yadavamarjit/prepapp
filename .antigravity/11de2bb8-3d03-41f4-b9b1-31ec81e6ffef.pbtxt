  code_action {
    action_spec {
      create_file {
        instruction: "import { Paper2Prompt } from \'../types\';\n\nexport const PAPER_2_PROMPTS: Paper2Prompt[] = [\n  {\n    id: \'p2-arg-1\',\n    type: \'ARGUMENT\',\n    title: \'Deploying CAPFs for State Law & Order Undermines Border Security\',\n    prompt: \'Write arguments for and against the statement: \"Excessive deployment of Central Armed Police Forces (CAPFs) for state internal security and election duties undermines their primary mandate of external border defense and border guarding.\"\',\n    wordLimit: 300,\n    suggestedMinutes: 20,\n    contextTags: [\'MHA Mandate\', \'Border Security\', \'Internal Policing\', \'Federalism\'],\n  },\n  {\n    id: \'p2-arg-2\',\n    type: \'ARGUMENT\',\n    title: \'One Nation, One Election Weakens India\\\'s Federal Structure\',\n    prompt: \'Write arguments for and against the statement: \"Simultaneous elections (One Nation, One Election) will compromise India\\\'s federal architecture and marginalize local regional issues.\"\',\n    wordLimit: 300,\n    suggestedMinutes: 20,\n    contextTags: [\'Polity\', \'Article 356\', \'Kovind Committee\', \'Electoral Reforms\'],\n  },\n  {\n    id: \'p2-arg-3\',\n    type: \'ARGUMENT\',\n    title: \'Privatization of Defence Production is Indispensable for Atmanirbharta\',\n    prompt: \'Write arguments for and against the statement: \"Corporatization and private sector induction in defence manufacturing is indispensable for achieving technological self-reliance in India\\\'s armed forces.\"\',\n    wordLimit: 300,\n    suggestedMinutes: 20,\n    contextTags: [\'Defence Capital\', \'DPSUs\', \'Atmanirbhar Bharat\', \'Security Audits\'],\n  },\n  {\n    id: \'p2-essay-1\',\n    type: \'ESSAY\',\n    title: \'Integrated Theatre Commands and Border Synergy in Modern Warfare\',\n    prompt: \'Discuss the strategic imperative of Integrated Theatre Commands (ITCs) and the necessity of seamless coordination between the Armed Forces and Central Armed Police Forces (BSF, ITBP, Assam Rifles) along India\\\'s contested frontiers.\',\n    wordLimit: 300,\n    suggestedMinutes: 25,\n    contextTags: [\'CDS Reforms\', \'Two-Front Challenge\', \'Inter-Force Synergy\', \'Joint Doctrine\'],\n  },\n  {\n    id: \'p2-essay-2\',\n    type: \'ESSAY\',\n    title: \'Artificial Intelligence in Border Surveillance & Counter-Terrorism\',\n    prompt: \'Analyze the integration of Artificial Intelligence, autonomous drones, and smart fencing along India\\\'s international borders. Address operational advantages and data security challenges.\',\n    wordLimit: 300,\n    suggestedMinutes: 25,\n    contextTags: [\'Smart Fencing CIBMS\', \'Internal Security\', \'UAV Warfare\', \'Data Privacy\'],\n  },\n  {\n    id: \'p2-rep-1\',\n    type: \'REPORT\',\n    title: \'Drone Infiltration Along Western Frontier & Counter-UAS Deployments\',\n    prompt: \'Draft a standard UPSC format report (Date, Place, Special Correspondent) on the surge in cross-border drone incursions smuggling narcotics and arms along the Punjab-Rajasthan border and the BSF\\\'s anti-drone grid.\',\n    wordLimit: 200,\n    suggestedMinutes: 15,\n    contextTags: [\'BSF Operations\', \'Counter-UAS\', \'Cross-Border Narcotics\', \'MHA Directives\'],\n  },\n  {\n    id: \'p2-rep-2\',\n    type: \'REPORT\',\n    title: \'Glacial Outburst Rescue & Disaster Response in Sikkim Himalayas\',\n    prompt: \'Draft an official news report on the multi-agency rescue operations conducted by the ITBP, Army, and NDRF following flash floods and glacial lake outbursts affecting remote forward posts.\',\n    wordLimit: 200,\n    suggestedMinutes: 15,\n    contextTags: [\'ITBP High Altitude\', \'NDRF\', \'Disaster Management Act 2005\', \'Border Infrastructure\'],\n  },\n  {\n    id: \'p2-precis-1\',\n    type: \'PRECIS\',\n    title: \'Civil-Military Relations and Constitutional Supremacy in Democratic Polities\',\n    prompt: \'Make a pr\303\251cis of the following passage in about one-third of its original length. Provide a suitable title.\',\n    wordLimit: 95,\n    suggestedMinutes: 20,\n    contextTags: [\'Constitutional Law\', \'Supreme Command\', \'Democratic Control\', \'Institutional Balance\'],\n    originalPassage: `The supremacy of civilian authority over the military establishment is one of the foundational hallmarks of a constitutional democracy. In democratic governance, the primary role of the armed forces and security apparatus is to safeguard territorial sovereignty and preserve domestic peace against existential threats, strictly within the constitutional perimeter. However, this civilian oversight must not degenerate into bureaucratic micromanagement or the politicization of operational doctrines. When security establishments are insulated from transient electoral pressures while remaining strictly accountable to the elected legislature, national security policy achieves both strategic continuity and moral legitimacy. Historical experience across post-colonial republics demonstrates that democracies falter when the boundary between political leadership and uniformed commands becomes porous. Therefore, a modern democracy requires institutionalized advisory channels, professionalized defence councils, and rigorous legislative oversight that respect operational military expertise without ceding the ultimate decision-making power of the sovereign people. True military effectiveness in the 21st century is inseparable from the democratic values that the armed forces are sworn to protect.`,\n  },\n];\n"
        path {
          absolute_uri: "file:///src/data/paper2Prompts.ts"
        }
        overwrite: true
      }
    }
