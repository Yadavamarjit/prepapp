            }
            lines {
              text: "// 2. AI Question Generator: Personalized practice questions for learning gaps"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "app.post(\'/api/ai/generate-questions\', async (req, res) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const { topic, subject, examTrack, specificGap, count = 3, adaptiveAssessment } = req.body;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const requestedCount = Math.min(Math.max(1, Number(count) || 3), 5);"
