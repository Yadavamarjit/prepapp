      name: "write_to_file"
      arguments_json: "{\"Append\":false, \"CodeContent\":\"import { SyllabusModule } from \'../types\';\\n\\nexport const SYLLABUS_MODULES: SyllabusModule[] = [\\n  {\\n    id: \'syl-polity\',\\n    subject: \'Polity & Constitution\',\\n    iconName: \'Scale\',\\n    description: \'Shared Core: Covers constitutional framework, fundamental rights, armed forces exceptions, and executive emergency powers.\',\\n    isSharedCore: true,\\n    subtopics: [\\n      {\\n        id: \'pol-emergency\',\\n        title: \'Emergency Provisions (Art 352, 356, 360)\',\\n        isShared: true,\\n        examFocus: [\'CAPF\', \'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'M. Laxmikanth Ch. 16 (Emergency Provisions)\',\\n        keyConcepts: [\\n          \'44th Amendment Act 1978 safeguards\',\\n          \'Parliamentary approval timelines (1 month vs 2 months)\',\\n          \'Armed Rebellion grounds vs Internal Disturbance\',\\n          \'Article 358 & 359 suspensions of Fundamental Rights\',\\n        ],\\n      },\\n      {\\n        id: \'pol-armed-forces\',\\n        title: \'Armed Forces & Fundamental Rights (Art 33, 34, 35)\',\\n        isShared: false,\\n        examFocus: [\'CAPF\'],\\n        weightage: \'High\',\\n        standardRef: \'M. Laxmikanth Ch. 7 (Fundamental Rights Special Powers)\',\\n        keyConcepts: [\\n          \'Parliamentary monopoly on restricting rights of armed/police forces\',\\n          \'Martial Law vs National Emergency operational distinctions\',\\n          \'Indemnity acts passed under Article 34\',\\n        ],\\n      },\\n      {\\n        id: \'pol-governor\',\\n        title: \'Governor Discretionary Powers & State Executive (Art 163, 174)\',\\n        isShared: true,\\n        examFocus: [\'CAPF\', \'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'M. Laxmikanth Ch. 30 (Governor)\',\\n        keyConcepts: [\\n          \'Constitutional discretion vs Situational discretion\',\\n          \'S.R. Bommai case guidelines on Art 356 report\',\\n          \'Discretionary reservation of bills for President under Art 200\',\\n        ],\\n      },\\n      {\\n        id: \'pol-preamble\',\\n        title: \'Preamble, Basic Structure & Amendments (Art 368)\',\\n        isShared: true,\\n        examFocus: [\'CAPF\', \'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'M. Laxmikanth Ch. 4 & Ch. 11\',\\n        keyConcepts: [\\n          \'Kesavananda Bharati (1973) Basic Structure Doctrine\',\\n          \'42nd Amendment (1976) additions: Socialist, Secular, Integrity\',\\n          \'Non-justiciable nature of Preamble\',\\n        ],\\n      },\\n    ],\\n  },\\n  {\\n    id: \'syl-history\',\\n    subject: \'Modern History\',\\n    iconName: \'BookOpen\',\\n    description: \'Shared Core: Freedom struggle from 1857 to 1947, revolutionary movements, and constitutional acts.\',\\n    isSharedCore: true,\\n    subtopics: [\\n      {\\n        id: \'hist-reforms\',\\n        title: \'1909, 1919 & 1935 Government of India Acts\',\\n        isShared: true,\\n        examFocus: [\'CAPF\', \'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'Spectrum Modern India Ch. 15, 16, 23\',\\n        keyConcepts: [\\n          \'1909 Morley-Minto communal electorates for Muslims\',\\n          \'1919 Montagu-Chelmsford Provincial Dyarchy and Central Bicameralism\',\\n          \'1935 Provincial Autonomy, Federal Court, Reserve Bank of India establishment\',\\n        ],\\n      },\\n      {\\n        id: \'hist-socio-reform\',\\n        title: \'Socio-Religious Reform Movements & Literature\',\\n        isShared: true,\\n        examFocus: [\'CAPF\', \'CPO\'],\\n        weightage: \'Medium\',\\n        standardRef: \'Spectrum Modern India Ch. 8 & 9\',\\n        keyConcepts: [\\n          \'Brahmo Samaj, Arya Samaj, Satyashodhak Samaj (Jyotirao Phule)\',\\n          \'Aligarh Movement and Theosophical Society\',\\n          \'Key journals: Sambad Kaumudi, Rast Goftar, Harijan, Young India\',\\n        ],\\n      },\\n      {\\n        id: \'hist-ina\',\\n        title: \'Subhas Chandra Bose, INA & Military Mutinies (1942\342\200\2231946)\',\\n        isShared: false,\\n        examFocus: [\'CAPF\'],\\n        weightage: \'High\',\\n        standardRef: \'Spectrum Modern India Ch. 25 (Post-War National Scenario)\',\\n        keyConcepts: [\\n          \'Azad Hind Fauj regiments and Rani of Jhansi Regiment\',\\n          \'Red Fort INA Trials (1945) legal defense by Bhulabhai Desai\',\\n          \'Royal Indian Navy (RIN) Mutiny of HMIS Talwar (Feb 1946)\',\\n        ],\\n      },\\n    ],\\n  },\\n  {\\n    id: \'syl-quant\',\\n    subject: \'Quantitative Aptitude\',\\n    iconName: \'Calculator\',\\n    description: \'SSC CPO Heavyweight: 50 Questions / high-speed mental shortcuts and multi-step arithmetic.\',\\n    isSharedCore: false,\\n    subtopics: [\\n      {\\n        id: \'quant-ci-si\',\\n        title: \'Compound vs Simple Interest (2-Year & 3-Year Shortcuts)\',\\n        isShared: false,\\n        examFocus: [\'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'R.S. Aggarwal / Pinnacle SSC Arithmetic\',\\n        keyConcepts: [\\n          \'2-year difference formula: D = P(R/100)\302\262\',\\n          \'3-year difference formula: D = P(R/100)\302\262 \303\227 (3 + R/100)\',\\n          \'Half-yearly compounding rate and period conversions\',\\n        ],\\n      },\\n      {\\n        id: \'quant-tracks\',\\n        title: \'Speed, Time & Distance: Circular Tracks & Trains\',\\n        isShared: false,\\n        examFocus: [\'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'R.S. Aggarwal / Kiran SSC Maths\',\\n        keyConcepts: [\\n          \'Relative speed in same direction (v1 - v2) vs opposite (v1 + v2)\',\\n          \'Time to first meeting on circular track: Track / Relative Speed\',\\n          \'Time to meet at starting point: LCM of individual round times\',\\n        ],\\n      },\\n      {\\n        id: \'quant-profit\',\\n        title: \'Successive Discounts, Marked Price & Dishonest Dealer\',\\n        isShared: false,\\n        examFocus: [\'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'Kiran SSC Chapterwise Quant\',\\n        keyConcepts: [\\n          \'Effective discount formula: x + y - (xy / 100)\',\\n          \'Faulty weight profit formula: (Error / (True Value - Error)) \303\227 100\',\\n          \'Ratio method for cascading marked price multipliers\',\\n        ],\\n      },\\n    ],\\n  },\\n  {\\n    id: \'syl-reasoning\',\\n    subject: \'Reasoning & Intelligence\',\\n    iconName: \'Cpu\',\\n    description: \'SSC CPO Heavyweight: 50 Questions / High-speed pattern recognition, syllogisms, and matrix analogies.\',\\n    isSharedCore: false,\\n    subtopics: [\\n      {\\n        id: \'reas-syllogisms\',\\n        title: \'Syllogisms (Venn Diagrams, Either-Or, Possibility Cases)\',\\n        isShared: false,\\n        examFocus: [\'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'Arihant Verbal Reasoning / CPO PYQ Sets\',\\n        keyConcepts: [\\n          \'3 rules for \\\"Either-Or\\\" complimentary pairs (Some + No, All + Some Not)\',\\n          \'Definite conclusions vs Possibility statements\',\\n          \'Negative premise boundaries (No X is Y)\',\\n        ],\\n      },\\n      {\\n        id: \'reas-coding\',\\n        title: \'Advanced Alphanumeric Coding & Reverse Letter Shifts\',\\n        isShared: false,\\n        examFocus: [\'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'SSC CPO Reasoning Master\',\\n        keyConcepts: [\\n          \'Alphabet opposite pairs (A-Z, B-Y, C-X, D-W, E-V... \\\"EJOTY\\\" rule)\',\\n          \'Positional value addition and cross-diagonal swaps\',\\n          \'Vowel vs Consonant distinct arithmetic shift rules\',\\n        ],\\n      },\\n    ],\\n  },\\n  {\\n    id: \'syl-geography\',\\n    subject: \'Geography & Environment\',\\n    iconName: \'Globe\',\\n    description: \'Shared Core: Physical physiography of India, drainage basins, Himalayan frontiers, and strategic geography.\',\\n    isSharedCore: true,\\n    subtopics: [\\n      {\\n        id: \'geo-peninsular\',\\n        title: \'Physiography: Western Ghats, Eastern Ghats & Island Groups\',\\n        isShared: true,\\n        examFocus: [\'CAPF\', \'CPO\'],\\n        weightage: \'High\',\\n        standardRef: \'NCERT Class 11 India: Physical Environment Ch. 2\',\\n        keyConcepts: [\\n          \'Continuity of Western Ghats (Thal Ghat, Bhor Ghat, Palghat gaps)\',\\n          \'Highest peaks: Anamudi (2695m) vs Dodabetta vs Jindhagada\',\\n          \'Ten Degree Channel (Andaman vs Nicobar) and Duncan Passage\',\\n        ],\\n      },\\n      {\\n        id: \'geo-security\',\\n        title: \'Border Geography & CAPF Operational Mandates\',\\n        isShared: false,\\n        examFocus: [\'CAPF\'],\\n        weightage: \'High\',\\n        standardRef: \'MHA Annual Report / Internal Security Manual\',\\n        keyConcepts: [\\n          \'BSF: Pakistan (3323 km) and Bangladesh (4096 km) borders\',\\n          \'ITBP: Indo-China LAC (3488 km) Karakoram to Jachep La\',\\n          \'SSB: Nepal (1751 km) and Bhutan (699 km) friendly frontiers\',\\n          \'Assam Rifles: Indo-Myanmar border (1643 km)\',\\n        ],\\n      },\\n    ],\\n  },\\n  {\\n    id: \'syl-paper2\',\\n    subject: \'Paper 2 (Subjective)\',\\n    iconName: \'PenTool\',\\n    description: \'UPSC CAPF AC Paper 2 Exclusive: 200 Marks descriptive paper (Essays 80M, Arguments 40M, Reports 20M, Pr\303\251cis 15M, Comprehension & Grammar).\',\\n    isSharedCore: false,\\n    subtopics: [\\n      {\\n        id: \'p2-sub-argument\',\\n        title: \'Counter-Argument Writing (For & Against Architecture)\',\\n        isShared: false,\\n        examFocus: [\'CAPF\'],\\n        weightage: \'High\',\\n        standardRef: \'UPSC CAPF Paper 2 Rubric (40 Marks: 2 \303\227 20M)\',\\n        keyConcepts: [\\n          \'Neutral, non-partisan introduction framing the dilemma\',\\n          \'3 robust arguments FOR supported by constitutional/economic logic\',\\n          \'3 robust arguments AGAINST highlighting operational vulnerabilities\',\\n          \'Balanced, pragmatic conclusion (Way Forward)\',\\n        ],\\n      },\\n      {\\n        id: \'p2-sub-report\',\\n        title: \'Official Report Drafting (Header, Facts, Tone)\',\\n        isShared: false,\\n        examFocus: [\'CAPF\'],\\n        weightage: \'High\',\\n        standardRef: \'UPSC CAPF Paper 2 Rubric (20 Marks: 2 \303\227 10M)\',\\n        keyConcepts: [\\n          \'Mandatory Header: Headline | Date, Place | Special Correspondent\',\\n          \'Strictly objective third-person passive journalistic tone\',\\n          \'Chronology of incident, official response, casualties/damage, inquiry\',\\n        ],\\n      },\\n      {\\n        id: \'p2-sub-precis\',\\n        title: \'Pr\303\251cis Writing (Strict 1/3 Rule & Own Words)\',\\n        isShared: false,\\n        examFocus: [\'CAPF\'],\\n        weightage: \'High\',\\n        standardRef: \'UPSC CAPF Paper 2 Rubric (15 Marks)\',\\n        keyConcepts: [\\n          \'Precise 33% word count target (within \302\26110% tolerance)\',\\n          \'No direct cut-pasting; paraphrasing essential central thesis\',\\n          \'Crisp, informative 3-5 word title required\',\\n        ],\\n      },\\n    ],\\n  },\\n];\\n\", \"Description\":\"Structured syllabus data with micro-topics, exam weightage, and standard book references\", \"Overwrite\":true, \"TargetFile\":\"/src/data/syllabusData.ts\", \"toolAction\":\"Writing syllabus data\", \"toolSummary\":\"Create src/data/syllabusData.ts\"}"
