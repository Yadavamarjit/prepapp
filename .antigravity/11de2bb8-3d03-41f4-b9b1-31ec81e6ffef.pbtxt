    content: "              )}\n              {currentProficiency.consecutiveCorrect === 0 && currentProficiency.consecutiveIncorrect === 0 && (\n                <span>Baseline evaluation</span>\n              )}\n            </div>\n          </div>\n\n          {/* Tile 2: Statement Depth Tuning */}\n          <div className=\"p-3 rounded-lg bg-[#FFFFFF] dark:bg-[#121816] border border-[#EEF0EA] dark:border-slate-800\">\n            <div className=\"flex justify-between items-center\">\n              <span className=\"text-[10px] uppercase font-bold text-[#5C646B] tracking-wider\">\n                Statement Depth\n              </span>\n              <span className={`text-[10px] font-bold px-1.5 py-0.2 rounded ${\n                isManualOverride \n                  ? \'bg-[#36624B] text-white\' \n                  : \'bg-[#E3EFE8] text-[#36624B]\'\n              }`}>\n                {effectiveAssessment.statementDepth} Stmt{effectiveAssessment.statementDepth > 1 ? \'s\' : \'\'} {isManualOverride ? \'(Manual)\' : \'(Auto)\'}\n              </span>\n            </div>\n            \n            {/* Visual statement depth bar - 4 depth options */}\n            <div className=\"mt-2 grid grid-cols-4 gap-1 text-center\">\n              {([1, 2, 3, 4] as const).map((depth) => {\n                const isActive = effectiveAssessment.statementDepth === depth;\n                return (\n                  <button\n                    key={depth}\n                    type=\"button\"\n                    onClick={() => {\n                      setIsManualOverride(true);\n                      setManualDepth(depth);\n                    }}\n                    title={\n                      depth === 1\n                        ? \'1 Stmt: Single-statement factual recall\'\n                        : depth === 2\n                        ? \'2 Stmts: Foundational binary contrast\'\n                        : depth === 3\n                        ? \'3 Stmts: Standard UPSC CAPF elimination\'\n                        : \'4 Stmts: Complex multi-layered analysis\'\n                    }\n                    className={`py-1 rounded text-[11px] font-bold border transition-all cursor-pointer ${\n                      isActive\n                        ? \'bg-[#36624B] text-white border-[#36624B] shadow-xs\'\n                        : \'bg-[#F7F8F5] dark:bg-slate-900 text-[#5C646B] border-[#EEF0EA] hover:border-[#36624B]\'\n                    }`}\n                  >\n                    {depth} Stmt{depth > 1 ? \'s\' : \'\'}\n                  </button>\n                );\n              })}\n            </div>\n            <div className=\"mt-1 text-[10px] text-[#5C646B] truncate\">\n              {effectiveAssessment.statementDepth === 1 && \'Factual recall (Direct CBT format)\'}\n              {effectiveAssessment.statementDepth === 2 && \'Remedial / Binary contrast (1 & 2)\'}\n              {effectiveAssessment.statementDepth === 3 && \'Standard UPSC elimination (1, 2, 3)\'}\n              {effectiveAssessment.statementDepth === 4 && \'Complex analysis (1, 2, 3, 4)\'}\n            </div>\n          </div>"
