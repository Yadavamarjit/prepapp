            lines {
              text: "            \'Under Article 34, Parliament can indemnify any person in service of the Union or a State in respect of any act done in connection with the maintenance of order during martial law.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          options: ["
