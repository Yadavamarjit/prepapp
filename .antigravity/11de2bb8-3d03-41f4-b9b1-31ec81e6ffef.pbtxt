              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'pol-chap-2\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Polity & Constitution\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ncertBook: \'NCERT Class 11: Indian Constitution at Work (Ch. 2) & Laxmikanth Ch. 7\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterNumber: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterTitle: \'Fundamental Rights (Articles 12-35) & Armed Forces Special Powers (Articles 33-35)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    readTimeMinutes: 24,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examRelevance: [\'UPSC_CAPF\', \'SSC_CPO\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightage: \'Very High\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    coreConcepts: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Definition of State (Article 12) & Laws Inconsistent with FRs (Article 13)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Right to Equality (Articles 14-18) & Right to Freedom (Articles 19-22)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Article 21: Protection of Life, Personal Liberty & the Maneka Gandhi Test\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Constitutional Remedies & 5 Writs (Article 32)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Article 33: Restriction of FRs for Armed & Police Forces (CAPF Core Mandate)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Article 34: Martial Law vs National Emergency & Indemnity Acts\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summaryOverview:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Part III (Articles 12-35) forms the \"Magna Carta of India\". While rights are guaranteed against arbitrary state action, Article 33 gives Parliament exclusive power to restrict rights for armed forces and CAPFs to maintain discipline, and Article 34 indemnifies acts during Martial Law.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sections: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'1. The Six Broad Categories of Fundamental Rights\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Originally 7 rights; Right to Property (Article 31) was deleted by the 44th Amendment Act 1978 and made a legal right under Article 300A in Part XII.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        tableData: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          headers: [\'Right Category\', \'Articles\', \'Salient Protective Scope\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rows: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Right to Equality\', \'Art 14\342\200\22318\', \'Rule of law, no discrimination, abolition of untouchability & titles\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Right to Freedom\', \'Art 19\342\200\22322\', \'Six democratic freedoms, protection against conviction, Art 21 Life/Liberty\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Against Exploitation\', \'Art 23\342\200\22324\', \'Prohibition of human trafficking, forced labor, & child labor in factories\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Freedom of Religion\', \'Art 25\342\200\22328\', \'Conscience, practice, propagation; secular character of the Indian state\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Cultural & Educational\', \'Art 29\342\200\22330\', \'Protection of language, script, culture of religious/linguistic minorities\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Constitutional Remedies\', \'Art 32\', \'Heart and Soul of the Constitution (Dr. Ambedkar); writ jurisdiction\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'2. The 5 Prerogative Writs under Article 32 & 226\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Article 32 is itself a Fundamental Right (Supreme Court jurisdiction), whereas Article 226 is a constitutional power (High Courts). High Courts have wider writ jurisdiction because they can issue writs for both Fundamental Rights and ordinary legal rights.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bulletPoints: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Habeas Corpus (\"To have the body of\"): Against unlawful detention; applicable against both state and private individuals.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Mandamus (\"We command\"): Directs public official/body to perform mandatory statutory duty; CANNOT be issued against President, Governor, or private entities.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Prohibition (\"To forbid\"): Issued by higher court to lower judicial/quasi-judicial tribunal to stop exceeding jurisdiction.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Certiorari (\"To be certified\"): Quashes order of inferior court/tribunal for excess of jurisdiction or error of law on the face of the record.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Quo-Warranto (\"By what authority\"): Prevents unlawful usurpation of public office; can be sought by any interested person, not only the aggrieved.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'3. Article 33 & 34: The Armed Forces & Security Mandate (CAPF Essential)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Article 33 empowers PARLIAMENT ALONE (State Legislatures have no power) to restrict or abrogate the Fundamental Rights of members of the Armed Forces, Paramilitary Forces (BSF, CRPF, CISF, ITBP, SSB), police forces, intelligence agencies, and telecommunication systems set up for forces.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Non-combatants (cooks, tailors, carpenters, mechanics attached to armed forces) ARE covered under Article 33 as held by the Supreme Court in Viswan v. Union of India.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    upscCapfAnalyticalAngle:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'In CAPF Paper 1: Remember that laws passed under Article 33 cannot be challenged in any court on the ground of contravention of any Fundamental Right (e.g. BSF Act 1968, CRPF Act 1949 restrict unionization, public speech, and press interactions). In Paper 2, cite Article 33 when justifying why uniform personnel must remain apolitical.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sscCpoSpeedShortcut:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'CPO Direct Rules: Untouchability abolished = Art 17. Right to Education (6-14 yrs) = Art 21A (86th Act 2002). Heart & Soul of Constitution = Art 32. Right to Property = Legal right under Art 300A (44th Act 1978).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examinerTraps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Assuming High Court writ jurisdiction (Art 226) is narrower than Supreme Court (Art 32) (Trap: Art 226 is WIDER because it covers both FRs and legal rights).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Thinking State Legislatures can legislate on Article 33 (Trap: Parliament alone has exclusive power under Article 35).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    highYieldMnemonics: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Writs Order Mnemonic: \"H-M-P-C-Q\" (Habeas Corpus, Mandamus, Prohibition, Certiorari, Quo-Warranto).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Articles 20 & 21 Mnemonic: \"UNTOUCHABLE 20-21\" (Can never be suspended even in Emergency).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comprehensionQuiz: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        question: \'Which constitutional writ can be issued against private individuals as well as public authorities?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options: [\'Mandamus\', \'Habeas Corpus\', \'Quo-Warranto\', \'Prohibition\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Habeas Corpus can be issued against both public authorities and private individuals who unlawfully detain someone.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        question: \'Under Article 33 of the Constitution, who possesses the exclusive power to restrict the fundamental rights of members of the Armed Forces and Police?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options: [\'The President of India\', \'Parliament alone\', \'State Legislative Assemblies\', \'The Supreme Court of India\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Article 33 confers the power exclusively upon Parliament to restrict or abrogate the fundamental rights of armed/police forces.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'pol-chap-3\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Polity & Constitution\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ncertBook: \'NCERT Class 11 (Ch. 6) & Laxmikanth Ch. 16\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterNumber: 3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterTitle: \'Emergency Provisions (Articles 352, 356, 360) & Federal Impacts\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    readTimeMinutes: 20,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examRelevance: [\'UPSC_CAPF\', \'SSC_CPO\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightage: \'Very High\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    coreConcepts: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'National Emergency (Art 352): War, External Aggression, Armed Rebellion\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'President\342\200\231s Rule / State Emergency (Art 356 & Art 365)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Financial Emergency (Art 360) - Never declared in India\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The 44th Constitutional Amendment Act 1978 safeguards\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Suspension of Article 19 (Article 358) vs Other Rights (Article 359)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'S.R. Bommai Landmark Judicial Guidelines\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summaryOverview:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Emergency provisions in Part XVIII convert India\342\200\231s federal structure into a unitary state without formal constitutional amendments. The 44th Amendment Act 1978 instituted critical checks to prevent executive abuse.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sections: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'1. National Emergency (Article 352)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Proclaimed on 3 grounds: War, External Aggression (External Emergency), or Armed Rebellion (Internal Emergency). The 44th Amendment Act 1978 replaced \"Internal Disturbance\" with \"Armed Rebellion\" and mandated the \"Written recommendation of the Union Cabinet\" (not PM alone). Must be approved by both Houses of Parliament within 1 MONTH by Special Majority (majority of total membership + 2/3rd present and voting). Each extension lasts 6 months.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Article 352 approval needs 1 month & special majority. Disapproval requires only Lok Sabha with simple majority (1/10th members can notice a session).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'2. President\342\200\231s Rule (Article 356 & 365)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Imposed when governance cannot be carried on in accordance with the Constitution (Art 356) or when a state fails to comply with Union executive directions (Art 365). Must be approved by both Houses within 2 MONTHS by Simple Majority. Maximum period is 3 years (with Election Commission certification and National Emergency in place after 1 year).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        tableData: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          headers: [\'Feature\', \'National Emergency (Art 352)\', \'President\342\200\231s Rule (Art 356)\', \'Financial Emergency (Art 360)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rows: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Approval Time\', \'1 Month\', \'2 Months\', \'2 Months\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Majority Needed\', \'Special Majority\', \'Simple Majority\', \'Simple Majority\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'State Legislature\', \'Continues to exist (concurrent power)\', \'Suspended or Dissolved\', \'Not affected\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Revocation\', \'Lok Sabha alone can disapprove\', \'Presidential notification anytime\', \'Presidential notification\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'3. Fundamental Rights during Emergency (Art 358 vs 359)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Article 358 automatically suspends Article 19 freedoms, BUT ONLY when emergency is proclaimed on grounds of War or External Aggression (NEVER on Armed Rebellion). Article 359 empowers the President by order to suspend the right to move courts for enforcement of specified rights, BUT Articles 20 and 21 can NEVER be suspended (44th Amendment safeguard).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bulletPoints: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Art 358 operates automatically across the entire territory of India.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Art 359 requires a specific Presidential Order and can be confined to specified parts of India.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Neither Art 358 nor 359 can touch Articles 20 and 21.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    upscCapfAnalyticalAngle:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Classic UPSC elimination trap: Statement says \"During National Emergency, the state legislative assembly is dissolved.\" (FALSE: State legislatures continue to exist; Parliament gains concurrent legislative power under Art 250). In President\342\200\231s Rule, assembly is only suspended initially and should NOT be dissolved until Parliament approves the proclamation (S.R. Bommai case).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sscCpoSpeedShortcut:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'30-Second CBT Formula: \"1-Month vs 2-Months\". Article 352 = 1 Month (Special Maj). Articles 356 & 360 = 2 Months (Simple Maj). Financial Emergency (Art 360) has been declared ZERO times.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examinerTraps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Swapping \"Armed Rebellion\" with \"Internal Disturbance\" (44th Act removed internal disturbance).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Confusing Art 358 (auto-suspension of Art 19) with Art 359 (Presidential order required).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    highYieldMnemonics: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Timeline Mnemonic: \"352-356-360 = 1 Month, 2 Months, 2 Months\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Approval Mnemonic: \"Art 352 = Special; 356 & 360 = Simple\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comprehensionQuiz: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        question: \'Under Article 358, the six freedoms guaranteed under Article 19 are automatically suspended ONLY when National Emergency is declared on which ground?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options: [\'Armed Rebellion\', \'War or External Aggression\', \'Financial Instability\', \'Internal Disturbance\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Article 358 operates automatically to suspend Article 19 only on grounds of War or External Aggression (External Emergency).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 2. MODERN HISTORY"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'hist-chap-1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Modern History\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ncertBook: \'NCERT Class 12: Themes in Indian History (Part III) & Spectrum Ch. 15-23\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterNumber: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterTitle: \'Government of India Acts (1909, 1919, 1935) & Constitutional Evolution\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    readTimeMinutes: 22,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examRelevance: [\'UPSC_CAPF\', \'SSC_CPO\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightage: \'Very High\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    coreConcepts: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'1909 Morley-Minto Reforms: Separate Electorates for Muslims\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'1919 Montagu-Chelmsford Reforms: Provincial Dyarchy & Central Bicameralism\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Transferred vs Reserved Subjects under 1919 Act\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'1935 Government of India Act: Provincial Autonomy & Central Dyarchy\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Establishment of Federal Court (1937) and Reserve Bank of India (1935)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summaryOverview:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The British colonial administration introduced constitutional reforms in three major installments (1909, 1919, 1935) to manage rising nationalist pressure while deepening communal divisions through separate electorates.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sections: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'1. The 1909 Act (Morley-Minto Reforms)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Formally known as the Indian Councils Act 1909. Lord Minto was the Viceroy (\"Father of Communal Electorates\") and John Morley was Secretary of State. Introduced separate electorates for Muslims, legalizing communalism. For the first time, an Indian was appointed to the Viceroy\342\200\231s Executive Council (Satyendra Prasad Sinha, appointed as Law Member).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'1909 marked the entry of communal electorates into Indian statutory law.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'2. The 1919 Act (Montagu-Chelmsford Reforms)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Introduced DYARCHY in Provinces: divided provincial subjects into \"Transferred\" (administered by Governor with ministers responsible to the Legislative Council, e.g., education, local health) and \"Reserved\" (administered by Governor and his Executive Council without legislative accountability, e.g., police, finance, law & order). At the Centre, it introduced Bicameralism (Council of State and Legislative Assembly) and direct elections for the first time. Extended separate electorates to Sikhs, Indian Christians, Anglo-Indians, and Europeans.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        tableData: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          headers: [\'Feature\', \'1919 Act (Montford)\', \'1935 Act (GOI Act)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rows: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Dyarchy\', \'Introduced in Provinces\', \'Abolished in Provinces; Proposed at Centre\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Provincial Status\', \'Dyarchy division\', \'Provincial Autonomy granted\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'All-India Federation\', \'Not contemplated\', \'Provided for (never materialized)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Franchise Extension\', \'Extended to Sikhs, Anglo-Indians\', \'Extended to Women, Depressed Classes, Labor\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'3. The 1935 Government of India Act\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'The longest and most comprehensive colonial statute. Provided for an All-India Federation consisting of provinces and princely states (never materialized as princely states refused to join). Abolished dyarchy in provinces and introduced Provincial Autonomy. Divided legislative powers into 3 lists: Federal List (59 items), Provincial List (54 items), and Concurrent List (36 items). Residuary powers were vested in the Viceroy. Established the Federal Court (1937), Reserve Bank of India (1935), and Federal Public Service Commission.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bulletPoints: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Federal Court was established in Delhi (1937) with Sir Maurice Gwyer as first Chief Justice.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Residuary powers were given to the Governor-General (Viceroy), unlike the current Constitution where they belong to Parliament (Art 248).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    upscCapfAnalyticalAngle:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'In CAPF Paper 1: Note that dyarchy was abolished in PROVINCES by the 1935 Act and moved to the CENTRE (though central dyarchy never operated). In Paper 2 essays on Indian Federalism, trace the 3-fold legislative division back to the 1935 Seventh Schedule prototype.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sscCpoSpeedShortcut:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'CPO Rapid Rule: Dyarchy in Provinces = 1919 Act. Dyarchy at Centre & Provincial Autonomy = 1935 Act. Communal electorates for Muslims = 1909 Act. First Indian in Executive Council = S.P. Sinha (1909).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examinerTraps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Confusing which Act introduced provincial dyarchy (1919) with which Act abolished it (1935).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Assuming the All-India Federation actually came into force under the 1935 Act (Trap: It NEVER materialized).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    highYieldMnemonics: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Dyarchy Transition: \"1919 = Province Split; 1935 = Province Free (Autonomy)\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Father of Communal Electorates: \"Minto = Minted Communalism (1909)\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comprehensionQuiz: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        question: \'Under the Government of India Act 1935, where were the residuary legislative powers vested?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options: [\'Federal Legislature\', \'Provincial Legislatures\', \'Governor-General (Viceroy)\', \'Federal Court\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        correctIndex: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Under the 1935 Act, residuary powers were vested in the Governor-General (Viceroy) at his personal discretion.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'hist-chap-2\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Modern History\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ncertBook: \'NCERT Class 12 (Part III) & Spectrum Ch. 25-27\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterNumber: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterTitle: \'Subhas Chandra Bose, the INA & Military Mutinies (1942\342\200\2231946)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    readTimeMinutes: 20,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examRelevance: [\'UPSC_CAPF\', \'SSC_CPO\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightage: \'Very High\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    coreConcepts: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Formation of the Indian National Army (INA / Azad Hind Fauj)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Role of Mohan Singh, Rash Behari Bose & Subhas Chandra Bose\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Rani of Jhansi Women\342\200\231s Combat Regiment (Captain Lakshmi Sahgal)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'1945 Red Fort INA Trials & Mass Public Demonstrations\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Royal Indian Navy (RIN) Mutiny of HMIS Talwar (Feb 1946)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summaryOverview:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The military dimension of India\342\200\231s freedom struggle, spearheaded by Netaji Subhas Chandra Bose\342\200\231s INA and culminated by the 1946 Royal Indian Navy and Air Force mutinies, broke the colonial reliance on the armed forces and hastened British withdrawal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sections: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'1. Genesis of the Azad Hind Fauj (INA)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Initially conceived in Malaya by Captain Mohan Singh with Japanese Major Iwaichi Fujiwara using Indian Prisoners of War (POWs). Rash Behari Bose organized the Indian Independence League in Tokyo (1942). In July 1943, Subhas Chandra Bose arrived in Singapore and assumed supreme leadership of the Azad Hind Fauj, delivering his famous battle cry \"Chalo Delhi!\" and declaring the Provisional Government of Free India (Arzi Hukumat-e-Azad Hind) on 21 October 1943.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Netaji established the Rani of Jhansi Regiment, one of the earliest all-women combat infantry units in modern Asian military history, led by Captain Lakshmi Sahgal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'2. The Red Fort Trials (1945)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'The British military court staged public court-martial trials at the Red Fort in late 1945 against three INA officers: Prem Kumar Sahgal (Hindu), Gurbaksh Singh Dhillon (Sikh), and Shah Nawaz Khan (Muslim). This deliberate joint trial galvanized unprecedented pan-Indian communal unity. A heavyweight legal defense team was assembled comprising Bhulabhai Desai, Tej Bahadur Sapru, Jawaharlal Nehru, and Asaf Ali.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bulletPoints: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Massive demonstrations erupted across Bombay, Calcutta, and Delhi shouting \"Lal Qile se aayi aawaz: Sahgal, Dhillon, Shahnawaz!\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Viceroy Lord Wavell was compelled to use his prerogative to remit their transportation-for-life sentences due to fears of an army-wide revolt.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'3. The Royal Indian Navy (RIN) Mutiny (Feb 1946)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'On 18 February 1946, 1,100 naval ratings on the signal training ship HMIS Talwar in Bombay went on strike against racial discrimination, unpalatable food, and the arrest of B.C. Dutt (who wrote \"Quit India\" on the ship\342\200\231s sides). Ratings elected M.S. Khan as President of the Naval Central Strike Committee. Mutineers hoisted the tricolor, crescent, and hammer-and-sickle flags together.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Sardar Patel and M.A. Jinnah intervened to convince the ratings to surrender on 23 February 1946, with the famous parting statement: \"We surrender to India, not to Britain.\"\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    upscCapfAnalyticalAngle:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'High-yield CAPF question topic: Clement Attlee later admitted that the primary factor prompting the swift 1947 British transfer of power was the erosion of loyalty within the British Indian Army and Navy post-INA trials and RIN mutiny. In Paper 2 arguments on armed forces heritage, cite the INA\342\200\231s secular cohesion.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sscCpoSpeedShortcut:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'CPO Flash Points: HMIS Talwar rating strike = 18 Feb 1946. First head of INA = Mohan Singh. Netaji Singapore proclamation = 21 Oct 1943. INA Defense Counsel lead = Bhulabhai Desai.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examinerTraps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Confusing the initial founder of INA (Mohan Singh) with its subsequent supreme revitalizer (Subhas Chandra Bose).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Claiming Mahatma Gandhi or Nehru represented the ratings at surrender (Trap: Sardar Vallabhbhai Patel convinced them to surrender).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    highYieldMnemonics: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Trial Trio: \"S-D-S\" (Sahgal, Dhillon, Shah Nawaz).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Signal Ship: \"TALWAR = The Sword that cut the Navy ties\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comprehensionQuiz: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        question: \'Who was the lead counsel in the joint defense of the INA officers at the Red Fort Trials in 1945?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options: [\'Jawaharlal Nehru\', \'Bhulabhai Desai\', \'Tej Bahadur Sapru\', \'Sardar Patel\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Bhulabhai Desai served as the chief and lead defense counsel in the historic 1945 Red Fort court-martial trials.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 3. GEOGRAPHY & ENVIRONMENT"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'geo-chap-1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Geography & Environment\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ncertBook: \'NCERT Class 11: India - Physical Environment (Ch. 2) & MHA Border Geography\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterNumber: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterTitle: \'Border Geography of India & CAPF Security Operational Mandates\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    readTimeMinutes: 24,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examRelevance: [\'UPSC_CAPF\', \'SSC_CPO\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightage: \'Very High\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    coreConcepts: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Land Frontiers: 15,106.7 km border shared with 7 neighboring countries\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The \"One Border, One Force\" doctrine established by the Kargil Review Committee\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Border Security Force (BSF): Pakistan & Bangladesh borders\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Indo-Tibetan Border Police (ITBP): Indo-China LAC\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Sashastra Seema Bal (SSB): Indo-Nepal & Indo-Bhutan friendly frontiers\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Assam Rifles: Indo-Myanmar border & anti-insurgency\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Strategic Corridors: Siliguri Corridor (\"Chicken\342\200\231s Neck\"), Sir Creek, Kalapani, Doklam\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summaryOverview:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Border management in India is partitioned among specialized Central Armed Police Forces under the Ministry of Home Affairs according to the \"One Border, One Force\" principle. Understanding frontier terrain, international boundary lines, and force jurisdictions is indispensable for both CAPF and CPO.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sections: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'1. Land Boundaries of India by Length & Demarcation\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'India shares 15,106.7 km of land borders with 7 nations. Bangladesh shares the longest land border, followed by China, Pakistan, Nepal, Myanmar, Bhutan, and Afghanistan.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        tableData: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          headers: [\'Neighboring Country\', \'Border Length\', \'Guarding Force (CAPF)\', \'Boundary Line Name\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rows: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Bangladesh\', \'4,096.7 km\', \'Border Security Force (BSF)\', \'Radcliffe Line (Zero Line)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'China\', \'3,488 km\', \'Indo-Tibetan Border Police (ITBP)\', \'Line of Actual Control (LAC) / McMahon Line\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Pakistan\', \'3,323 km\', \'Border Security Force (BSF)\', \'Radcliffe Line / Line of Control (LoC)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Nepal\', \'1,751 km\', \'Sashastra Seema Bal (SSB)\', \'Open & Friendly Frontier (Peace Treaty 1950)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Myanmar\', \'1,643 km\', \'Assam Rifles\', \'Indo-Myanmar Border (Free Movement Regime)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Bhutan\', \'699 km\', \'Sashastra Seema Bal (SSB)\', \'Open & Friendly Himalayan Frontier\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Afghanistan\', \'106 km\', \'Under Pakistani illegal occupation (PoK)\', \'Durand Line (1896)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'2. The \"One Border, One Force\" Doctrine\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Post-Kargil War (1999), the Group of Ministers (GoM) recommended that to eliminate overlapping command structures, every international border must be allocated exclusively to a dedicated central border-guarding force.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bulletPoints: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'BSF (Estd. 1965 after Indo-Pak War; K.F. Rustamji founding DG): Guarding Western frontier (Thar Desert, Rann of Kutch, Punjab plains, J&K International Border) and Eastern frontier (Sundarbans riverine, Bengal, Tripura, Meghalaya, Assam).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'ITBP (Estd. 24 Oct 1962 during Sino-Indian War): High-altitude mountain force guarding Karakoram Pass (Ladakh) to Jachep La (Arunachal Pradesh) at altitudes ranging from 9,000 to 18,700 ft.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'SSB (Estd. 1963 as Special Service Bureau, designated border force 2001): Mandated to guard peaceful frontiers of Nepal and Bhutan while promoting border citizen affinity.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Assam Rifles (Estd. 1835 as Cachar Levy): The oldest paramilitary force in India, dual control (administrative under MHA, operational under Indian Army).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'3. Strategic Geographic Chokepoints\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Candidates must master India\342\200\231s sensitive geopolitical flashpoints: The Siliguri Corridor (a 20-22 km narrow strip in West Bengal connecting Mainland India to 8 Northeast States); Sir Creek (a 96-km tidal estuary in Rann of Kutch marshlands disputed by Pakistan); Doklam Plateau (trijunction of India, Bhutan, and China); and Lipulekh Pass (Uttarakhand trijunction border with Tibet and Nepal).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Ten Degree Channel separates the Andaman Islands from the Nicobar Islands. Duncan Passage separates South Andaman from Little Andaman.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    upscCapfAnalyticalAngle:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Direct Paper 1 staple: Border length ranking (Trick: \"Bachpan = B-Ch-P-N\" -> Bangladesh > China > Pakistan > Nepal). In Paper 2 reports and security arguments, discuss the Comprehensive Integrated Border Management System (CIBMS) and smart fencing along riverine stretches.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sscCpoSpeedShortcut:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'CPO Flash Facts: Longest border = Bangladesh (4,096.7 km). Shortest border = Afghanistan (106 km). ITBP founded = 1962. BSF founded = 1965. Oldest force = Assam Rifles (1835).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examinerTraps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Assuming China has the longest border with India (Trap: Bangladesh is significantly longer due to its undulating riverine boundary).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Confusing which force guards Indo-Myanmar border (It is Assam Rifles, NOT BSF).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    highYieldMnemonics: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Border Length Decreasing Order: \"BA-CH-PA-N MEIN M-B-A\" (Bangladesh, China, Pakistan, Nepal, Myanmar, Bhutan, Afghanistan).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Islands Separation: \"10 Degree = Andaman from Nicobar\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comprehensionQuiz: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        question: \'Which Central Armed Police Force is deployed along the friendly borders of India with Nepal and Bhutan?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options: [\'Border Security Force (BSF)\', \'Indo-Tibetan Border Police (ITBP)\', \'Sashastra Seema Bal (SSB)\', \'Central Reserve Police Force (CRPF)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        correctIndex: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'Sashastra Seema Bal (SSB) is mandated to guard the international borders of India with Nepal (1,751 km) and Bhutan (699 km).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        question: \'Which narrow geographic strip connects mainland India to the Northeastern states?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options: [\'Duncan Passage\', \'Sir Creek Corridor\', \'Siliguri Corridor\', \'Palk Strait\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        correctIndex: 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'The Siliguri Corridor (also known as the \"Chicken\342\200\231s Neck\") in West Bengal connects mainland India to the 8 Northeastern states.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 4. QUANTITATIVE APTITUDE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'quant-chap-1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Quantitative Aptitude\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ncertBook: \'High-Speed Quantitative Handbook for SSC CPO & CAPF P1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterNumber: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterTitle: \'Compound vs Simple Interest: Derivations & 30-Second Delta Shortcuts\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    readTimeMinutes: 20,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examRelevance: [\'SSC_CPO\', \'UPSC_CAPF\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightage: \'Very High\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    coreConcepts: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Fundamental difference: Simple Interest is linear, Compound Interest is exponential\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The 2-Year Difference Formula: D = P * (R/100)^2\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The 3-Year Difference Formula: D = P * (R/100)^2 * (3 + R/100)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Compounding periods: Half-Yearly (R/2, Time*2) & Quarterly (R/4, Time*4)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Effective Annual Rate (Successive Percentage formula: a + b + ab/100)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summaryOverview:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'In SSC CPO (50 Quant questions) and CAPF Paper 1, CI and SI problems are guaranteed high-weightage questions. Traditional long-division formulas take 3 minutes; utilizing the difference formula and fractional multipliers solves them in 25\342\200\22340 seconds.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sections: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'1. The Core 2-Year Difference Shortcut\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'When the difference between Compound Interest and Simple Interest for 2 years at an annual rate R% on principal P is given, bypass calculating SI and CI separately. Use the exact delta equation:\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        tableData: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          headers: [\'Duration\', \'Shortcut Formula\', \'Application Example\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rows: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'2 Years\', \'D = P \303\227 (R / 100)\302\262\', \'If P = \342\202\27110,000, R = 10%, D = 10,000 \303\227 (10/100)\302\262 = \342\202\271100\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'3 Years\', \'D = P \303\227 (R / 100)\302\262 \303\227 (3 + R / 100)\', \'If P = \342\202\27110,000, R = 10%, D = 100 \303\227 (3 + 0.10) = \342\202\271310\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'For 2 years, D is simply the interest on the first year\342\200\231s simple interest: D = SI_1year \303\227 (R / 100).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'2. The Fractional Multiplier & Successive Percent Method\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Convert standard percentages into irreducible fractions: 5% = 1/20, 10% = 1/10, 12.5% = 1/8, 16.67% = 1/6, 20% = 1/5. If rate is 10%, the principal grows from 10 to 11 in Year 1, and 100 to 121 in Year 2. The interest in 2 years is 21 units on 100 principal (21% effective rate).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bulletPoints: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Effective CI rate for 2 years at R%: E = 2R + (R\302\262 / 100)%.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Example: For R = 8%, SI in 2 yrs = 16%. CI in 2 yrs = 2(8) + 64/100 = 16.64%. The difference is exactly 0.64% of P.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Half-Yearly Compounding: Always halve the rate (R/2) and double the compounding periods (2T).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    upscCapfAnalyticalAngle:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'In CAPF Paper 1, question setters like word problems where money doubles in N years under compound interest and asks when it will become 8 times. Shortcut rule: If P becomes 2P in N years, it becomes 2^k * P in k * N years. To become 8 times (2^3), it takes 3 * N years.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sscCpoSpeedShortcut:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'CPO Rapid Trick: If a sum doubles in 4 years under CI, it becomes 8 times (2\302\263) in 4 \303\227 3 = 12 years. Under SI, it becomes 8 times (adding 7P) in 4 \303\227 7 = 28 years!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examinerTraps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Forgetting to double the time when compounding is half-yearly (e.g. 1.5 years becomes 3 periods).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Confusing CI doubling time with SI doubling time.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    highYieldMnemonics: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'2-Yr Delta: \"Delta = Principal times Rate-squared over Ten-Thousand\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'3-Yr Delta: \"2-Yr Delta times (3 + R/100)\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    comprehensionQuiz: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        question: \'If the difference between CI and SI on a certain sum of money for 2 years at 5% per annum is \342\202\27125, what is the principal?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        options: [\'\342\202\2715,000\', \'\342\202\27110,000\', \'\342\202\27112,000\', \'\342\202\27115,000\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        correctIndex: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        explanation: \'D = P(R/100)\302\262. 25 = P(5/100)\302\262 = P(1/400). P = 25 \303\227 400 = \342\202\27110,000.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 5. REASONING & GENERAL INTELLIGENCE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // -------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'reas-chap-1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Reasoning & Intelligence\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ncertBook: \'Master Deductive Logic & Pattern Recognition for SSC CPO\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterNumber: 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    chapterTitle: \'Syllogisms: Venn Diagrams, Either-Or Cases & Possibility Rules\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    readTimeMinutes: 16,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examRelevance: [\'SSC_CPO\', \'UPSC_CAPF\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightage: \'High\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    coreConcepts: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The 4 Classical Propositions: A (All), E (No), I (Some), O (Some Not)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The 3 Strict Conditions for \"Either-Or\" Complimentary Pairs\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Possibility Statements vs Definite Deductions\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Modern qualifiers: \"Only a few\" vs \"Few\" vs \"At least some\"\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summaryOverview:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Syllogism questions test deductive validity, not empirical truth. Aspirants must master standard Venn overlaps and the precise conditions that trigger an \"Either I or II follows\" complementary answer.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sections: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'1. The 3 Golden Rules for \"Either-Or\" Pairs\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'When two individual conclusions are individually FALSE (or indeterminate in a definite sense), they form an \"Either-Or\" pair ONLY if all three conditions are satisfied:\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bulletPoints: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Condition 1: Both conclusions must have the EXACT SAME subject and predicate.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Condition 2: Both conclusions must be individually INDETERMINATE (neither definitively true nor false on its own).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Condition 3: One conclusion must be positive and the other negative. Permissible pairs are: (Some + No) or (All + Some Not). Note: (All + No) NEVER forms an Either-Or pair!\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'(All + No) is NOT a complementary pair because both can be false simultaneously.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'2. Handling \"Only a Few\" in Modern Examinations\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'The statement \"Only a few A are B\" contains TWO hidden truths: 1. \"Some A are B\" AND 2. \"Some A are NOT B\". Therefore, a conclusion stating \"All A can be B\" is strictly FALSE.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    upscCapfAnalyticalAngle:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'CAPF P1 frequently uses multi-statement syllogisms with 3 premises. Always draw the minimal Venn diagram (the diagram with the least possible overlaps) to test whether a conclusion is universally valid.\',"
