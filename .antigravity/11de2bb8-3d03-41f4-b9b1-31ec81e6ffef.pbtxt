    content: "// 2. AI Question Generator: Personalized practice questions for learning gaps\napp.post(\'/api/ai/generate-questions\', async (req, res) => {\n  const { topic, subject, examTrack, specificGap, count = 3, adaptiveAssessment } = req.body;\n  const requestedCount = Math.min(Math.max(1, Number(count) || 3), 5);\n  const track = examTrack || \'UPSC_CAPF\';\n\n  const statementDepth = adaptiveAssessment?.statementDepth || 3;\n  const complexityLevel = adaptiveAssessment?.level || \'Standard\';\n  const targetTrap = adaptiveAssessment?.trapTypeToInject || \'None\';\n  const diagnosedGap = adaptiveAssessment?.identifiedGap || specificGap || \'Reinforce core principles\';\n\n  try {\n    const systemInstruction = `You are a senior question setter for UPSC CAPF AC and SSC CPO.\nCRITICAL ADAPTIVE CALIBRATION DIRECTIVE:\n- Complexity Level: ${complexityLevel.toUpperCase()}\n- Statement Depth: EXACTLY ${statementDepth} numbered statements per UPSC multi-statement question.\n- Diagnosed Learning Gap to Target: \"${diagnosedGap}\"\n- Trap Directive: Inject \"${targetTrap}\" traps to train aspirant\'s weaknesses.\n\nRules per statement depth:\n${\n  statementDepth === 1\n    ? `- FACTUAL RECALL LEVEL: Provide EXACTLY 1 direct single-statement objective question (Direct CBT format).\n- Do NOT provide numbered statements (1, 2, 3). Set \"statements\" to an empty array [].\n- \"type\" MUST be \"SINGLE_CHOICE\".\n- Options must be 4 direct alternatives (A, B, C, D) answering the direct question.\n- Focus on exact constitutional articles, amendment years, institutional headquarters, or statutory provisions.`\n    : statementDepth === 2\n    ? `- FOUNDATIONAL LEVEL: Provide EXACTLY 2 high-contrast numbered statements (1 and 2).\n- Options must be: \"A: 1 only\", \"B: 2 only\", \"C: Both 1 and 2\", \"D: Neither 1 nor 2\".\n- Focus on clear binary distinctions, essential constitutional articles, and textbook definitions to eliminate foundational confusion.`\n    : statementDepth === 4\n    ? `- ADVANCED LEVEL: Provide EXACTLY 4 multi-layered numbered statements (1, 2, 3, and 4).\n- Cover subtle constitutional nuances, statutory exceptions (e.g. Art 358 vs 359, Art 33-35, Commission recommendations).\n- Provide intricate elimination options (e.g. \"1 and 3 only\", \"1, 2 and 4 only\", \"2, 3 and 4 only\", \"1, 2, 3 and 4\").`\n    : `- STANDARD LEVEL: Provide EXACTLY 3 numbered statements (1, 2, and 3).\n- Canonical UPSC CAPF AC format with standard elimination patterns.`\n}`;\n\n    const prompt = `Generate ${requestedCount} practice questions for:\nTopic: \"${topic}\"\nSubject: \"${subject || \'General Studies\'}\"\nTarget Exam Track: \"${track}\"\nAdaptive Depth: ${statementDepth} statements per question (Complexity: ${complexityLevel})\nSpecific Learning Gap: \"${diagnosedGap}\"`;\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.8-flash\',\n      contents: prompt,\n      config: {\n        systemInstruction,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.ARRAY,\n          items: {\n            type: Type.OBJECT,\n            properties: {\n              id: { type: Type.STRING },\n              targetExam: {\n                type: Type.ARRAY,\n                items: { type: Type.STRING },\n              },\n              subject: { type: Type.STRING },\n              microTopic: { type: Type.STRING },\n              difficulty: { type: Type.STRING, enum: [\'Speed\', \'Analytical\'] },\n              type: { type: Type.STRING, enum: [\'SINGLE_CHOICE\', \'STATEMENT_BASED\'] },\n              questionText: { type: Type.STRING },\n              statements: {\n                type: Type.ARRAY,\n                items: { type: Type.STRING },\n              },\n              options: {\n                type: Type.ARRAY,\n                items: {\n                  type: Type.OBJECT,\n                  properties: {"
    num_lines: 730
