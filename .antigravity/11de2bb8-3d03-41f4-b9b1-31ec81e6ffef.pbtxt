          target_content: "    return res.json({ \n      success: true, \n      questions: fallbackQuestions,\n      adaptiveLevel: complexityLevel,\n      statementDepth,\n      notice: \'Adaptive questions generated based on current diagnosed learning gaps.\'\n    });\n  }\n});\n  } catch (error: any) {\n    console.warn(\'Gemini API question generation failed, using curated adaptive questions:\', error?.message);\n\n    // Fallback high-yield questions tailored to topic\n    const fallbackQuestions = [\n      {\n        id: `gen-${Date.now()}-1`,\n        targetExam: [\'UPSC_CAPF\'],\n        subject: subject || \'Polity & Constitution\',\n        microTopic: topic || \'Emergency Provisions\',\n        difficulty: \'Analytical\',\n        type: \'STATEMENT_BASED\',\n        questionText: `With reference to the consequences of a National Emergency declared under Article 352, consider the following statements:`,\n        statements: [\n          \'The executive power of the Union extends to directing any State regarding the manner in which its executive power is to be exercised.\',\n          \'The legislative power of the State Legislature is suspended, and Parliament alone can enact laws for the State.\',\n          \'The President can modify the constitutional distribution of revenues between the Union and the States.\',\n        ],\n        options: [\n          { key: \'A\', text: \'1 and 2 only\' },\n          { key: \'B\', text: \'1 and 3 only\' },\n          { key: \'C\', text: \'2 and 3 only\' },\n          { key: \'D\', text: \'1, 2 and 3\' },\n        ],\n        correctAnswer: \'B\',\n        explanation: {\n          coreConcept:\n            \'During National Emergency, the State Legislature is NOT suspended; it continues to function, but Parliament acquires concurrent power to legislate on State List subjects (Art 250).\',\n          shortcutOrTrick:\n            \'Eliminate Statement 2: State legislatures are suspended during President Rule (Art 356), NOT National Emergency (Art 352). Discarding 2 eliminates A, C, and D immediately!\',\n          standardBookRef: \'M. Laxmikanth \342\200\224 Chapter 16 (Effects of National Emergency)\',\n          trapAlert: \'Never confuse Art 352 (legislature not suspended) with Art 356 (legislature suspended or dissolved).\',\n        },\n        yearRef: \'Curriculum Adaptive Bank\',\n      },\n      {\n        id: `gen-${Date.now()}-2`,\n        targetExam: [\'SSC_CPO\', \'UPSC_CAPF\'],\n        subject: subject || \'Polity & Constitution\',\n        microTopic: topic || \'Emergency Approval\',\n        difficulty: \'Speed\',\n        type: \'SINGLE_CHOICE\',\n        questionText: `Under which Constitutional Amendment Act was the approval period for a Proclamation of National Emergency reduced from two months to one month?`,\n        options: [\n          { key: \'A\', text: \'42nd Constitutional Amendment Act, 1976\' },\n          { key: \'B\', text: \'44th Constitutional Amendment Act, 1978\' },\n          { key: \'C\', text: \'52nd Constitutional Amendment Act, 1985\' },\n          { key: \'D\', text: \'86th Constitutional Amendment Act, 2002\' },\n        ],\n        correctAnswer: \'B\',\n        explanation: {\n          coreConcept:\n            \'The 44th Constitutional Amendment Act of 1978 introduced major checks on emergency powers, reducing approval time from 2 months to 1 month and requiring a special majority.\',\n          shortcutOrTrick: \'42nd Amendment created emergency abuses; 44th Amendment created democratic safeguards.\',\n          standardBookRef: \'M. Laxmikanth Ch. 16\',\n        },\n        yearRef: \'Curriculum Speed Set\',\n      },\n      {\n        id: `gen-${Date.now()}-3`,\n        targetExam: [\'UPSC_CAPF\'],\n        subject: subject || \'Polity & Constitution\',\n        microTopic: topic || \'Fundamental Rights Suspension\',\n        difficulty: \'Analytical\',\n        type: \'STATEMENT_BASED\',\n        questionText: `Consider the following statements regarding suspension of Fundamental Rights during emergency:`,\n        statements: [\n          \'Article 358 operates automatically as soon as National Emergency is declared on any ground.\',\n          \'Article 359 requires a specific Presidential Order to suspend the enforcement of designated fundamental rights.\',\n          \'The right to move court for enforcement of Articles 20 and 21 can never be suspended under Article 359.\',\n        ],\n        options: [\n          { key: \'A\', text: \'1 and 2 only\' },\n          { key: \'B\', text: \'2 and 3 only\' },\n          { key: \'C\', text: \'1 and 3 only\' },\n          { key: \'D\', text: \'1, 2 and 3\' },\n        ],\n        correctAnswer: \'B\',\n        explanation: {\n          coreConcept:\n            \'Article 358 operates automatically ONLY on grounds of war or external aggression (not armed rebellion). Statements 2 and 3 are correct.\',\n          shortcutOrTrick: \'Statement 1 is false because \"any ground\" includes armed rebellion, which Art 358 excludes.\',\n          standardBookRef: \'M. Laxmikanth Ch. 16\',\n        },\n        yearRef: \'UPSC Elimination Practice\',\n      },\n    ];\n\n    return res.json({ success: true, questions: fallbackQuestions });\n  }\n});"
          replacement_content: "    return res.json({ \n      success: true, \n      questions: fallbackQuestions,\n      adaptiveLevel: complexityLevel,\n      statementDepth,\n      notice: \'Adaptive questions generated based on current diagnosed learning gaps.\'\n    });\n  }\n});"
