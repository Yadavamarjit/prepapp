  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@theme {\n  --color-canvas: #F7F8F5;\n  --color-canvas-subtle: #EEF0EA;\n  --color-surface: #FFFFFF;\n  --color-surface-hover: #F2F4F0;\n  --color-content-primary: #1E252B;\n  --color-content-secondary: #5C646B;\n  --color-content-muted: #8B949E;\n  --color-brand-sage: #36624B;\n  --color-brand-mint: #E3EFE8;\n  --color-brand-sage-dark: #2A4F3C;\n  --color-track-polity: #2F7C7E;\n  --color-track-quant: #D97746;\n  --color-track-history: #8C7837;\n  --color-track-paper2: #4B5A8E;\n  --color-status-correct: #2E7D5B;\n  --color-status-correct-wash: #E6F4EA;\n  --color-status-review: #C25345;\n  --color-status-review-wash: #FBEAE8;\n  \n  --font-sans: \"Plus Jakarta Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  --font-serif: \"Newsreader\", Merriweather, Georgia, serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n}\n\n:root {\n  color-scheme: light dark;\n}\n\nbody {\n  background-color: var(--color-canvas);\n  color: var(--color-content-primary);\n  font-family: var(--font-sans);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n.dark body {\n  background-color: #121816;\n  color: #E6EAE8;\n}\n\n/* Custom subtle scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(92, 100, 107, 0.25);\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(92, 100, 107, 0.45);\n}\n\n/* Strike-through scratchpad effect for UPSC elimination */\n.scratchpad-eliminated {\n  position: relative;\n  opacity: 0.45;\n  text-decoration: line-through;\n  text-decoration-color: #C25345;\n  text-decoration-thickness: 2px;\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
