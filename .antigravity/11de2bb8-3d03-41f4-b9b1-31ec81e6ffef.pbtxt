              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      coreConcept: \'Assume CP = 100. MP = 140. After 20% discount: 140 \303\227 0.8 = 112. After 10% cash discount: 112 \303\227 0.9 = 100.8. Net Selling Price = 100.8. Overall profit = 100.8 - 100 = +0.8%.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      shortcutOrTrick: \'Multiplier method: 1.40 \303\227 0.80 \303\227 0.90 = 1.40 \303\227 0.72 = 1.008 -> 0.8% Profit.\',"
