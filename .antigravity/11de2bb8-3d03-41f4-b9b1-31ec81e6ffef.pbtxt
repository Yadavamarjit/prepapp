            }
            lines {
              text: "      \'Constituent Assembly composition & Cabinet Mission Plan 1946\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Historical Evolution: 1773 Regulating Act, 1858 Crown Rule, 1935 GOI Act\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Dr. B.R. Ambedkar & Drafting Committee roles\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Sources borrowed: Parliamentary from UK, Fundamental Rights from USA, DPSP from Ireland\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summaryOverview:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The Indian Constitution is not an overnight creation; it was deliberated over 2 years, 11 months, and 18 days by the Constituent Assembly. It synthesizes democratic universal adult suffrage with rigorous federal and unitary balances suited for India\342\200\231s diversity.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sections: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'1. Why Do We Need a Constitution? (NCERT Foundational Thesis)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'A Constitution provides the primary set of basic rules that allow for minimal coordination among members of a society. Furthermore, it specifies who has the power to make decisions in society and decides how the government will be constituted. Most importantly, it sets limits on what a government can impose on its citizens through non-derogable Fundamental Rights.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        keyTakeaway:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Constitutionalism means limited government: sovereignty belongs to the people, exercised within constitutional boundaries.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'2. The Constituent Assembly (Genesis & Working)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Drafted based on the Cabinet Mission Plan of 1946. Total initial strength was 389 (reduced to 299 after Partition). First meeting occurred on 9 December 1946 with Dr. Sachchidananda Sinha as interim President, followed by Dr. Rajendra Prasad elected as permanent President. On 13 December 1946, Jawaharlal Nehru moved the historic \"Objectives Resolution\", which subsequently became the philosophical beacon for the Preamble.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        tableData: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          headers: [\'Committee\', \'Chairman\', \'Key Mandate\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          rows: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Drafting Committee\', \'Dr. B.R. Ambedkar\', \'Drafted the primary text (7 members)\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Union Powers Committee\', \'Jawaharlal Nehru\', \'Federal vs central list demarcation\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Provincial Constitution\', \'Sardar Vallabhbhai Patel\', \'Integration of princely states\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            [\'Fundamental Rights Sub-Com.\', \'J.B. Kripalani\', \'Justiciable fundamental rights formulation\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        heading: \'3. Structural Borrowings from World Constitutions\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        content:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'The Indian Constitution is termed an \"Eclectic Document\" because the framers ransacked world constitutions to adopt proven mechanisms while adjusting them for Indian conditions. Over 60% of administrative provisions stem directly from the Government of India Act 1935 (Federal Scheme, Office of Governor, Judiciary, Public Service Commissions).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        bulletPoints: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'UK: Parliamentary form, Rule of Law, Single Citizenship, Bicameralism, Cabinet system.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'USA: Fundamental Rights, Independence of Judiciary, Judicial Review, Impeachment of President.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Ireland (Irish Constitution): Directive Principles of State Policy (DPSP), Nomination of Rajya Sabha members.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Canada: Federation with a strong Centre, Residuary powers to Centre (Art 248), Advisory jurisdiction of SC (Art 143).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Australia: Concurrent List (Seventh Schedule), Freedom of Trade and Commerce, Joint Sitting of Parliament (Art 108).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Germany (Weimar): Suspension of Fundamental Rights during National Emergency.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'USSR: Fundamental Duties (Art 51A), Ideals of Justice (Social, Economic, Political in Preamble).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    upscCapfAnalyticalAngle:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'In CAPF Paper 1, question setters frequently test whether the Constituent Assembly was directly elected (FALSE: it was indirectly elected by provincial assemblies via single transferable vote). In Paper 2 essays, use the \"Constitutional Morality\" concept (Dr. Ambedkar) to argue for institutional integrity over raw executive discretion.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    sscCpoSpeedShortcut:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'CPO Flash Fact: Time taken = 2 yrs 11 mos 18 days. Enacted on 26 Nov 1949 (Constitution Day); fully commenced on 26 Jan 1950 (commemorating 1930 Purna Swaraj Day). Drafting Committee had 7 members.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    examinerTraps: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Claiming the Constituent Assembly was elected on Universal Adult Suffrage (Trap: Suffrage was limited by property, tax, and education under the 1935 Act).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Confusing the Joint Sitting origin (Australia) with Parliamentary System origin (UK).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
