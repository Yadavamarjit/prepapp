      arguments_json: "{\"Append\":false, \"CodeContent\":\"import { MistakeRecord } from \'../types\';\\n\\nconst ONE_DAY_MS = 24 * 60 * 60 * 1000;\\n\\nexport function calculateNextSrsDate(reviewCount: number, baseTimestamp = Date.now()): number {\\n  if (reviewCount <= 0) {\\n    return baseTimestamp + ONE_DAY_MS; // 1 day\\n  }\\n  if (reviewCount === 1) {\\n    return baseTimestamp + 3 * ONE_DAY_MS; // 3 days\\n  }\\n  return baseTimestamp + 7 * ONE_DAY_MS; // 7 days\\n}\\n\\nexport type MistakeVaultFilter = \'ALL\' | \'CONCEPTUAL_GAP\' | \'REPEAT_MISTAKES\' | \'DUE_FOR_REVIEW\' | \'TIME_PANIC\';\\n\\nexport function filterMistakeRecords(\\n  records: MistakeRecord[],\\n  filter: MistakeVaultFilter,\\n  currentTimestamp = Date.now()\\n): MistakeRecord[] {\\n  switch (filter) {\\n    case \'CONCEPTUAL_GAP\':\\n      return records.filter((r) => r.reason === \'Conceptual Gap\');\\n    case \'REPEAT_MISTAKES\':\\n      return records.filter((r) => r.reviewCount >= 2);\\n    case \'TIME_PANIC\':\\n      return records.filter((r) => r.reason === \'Calculation/Time Panic\');\\n    case \'DUE_FOR_REVIEW\':\\n      return records.filter((r) => r.nextReviewDate <= currentTimestamp);\\n    case \'ALL\':\\n    default:\\n      return records;\\n  }\\n}\\n\\nexport function getMistakeTaxonomyBreakdown(records: MistakeRecord[]) {\\n  const counts = {\\n    conceptual: 0,\\n    misread: 0,\\n    timePanic: 0,\\n    unclassified: 0,\\n  };\\n\\n  records.forEach((r) => {\\n    if (r.reason === \'Conceptual Gap\') counts.conceptual++;\\n    else if (r.reason === \'Misread Question\') counts.misread++;\\n    else if (r.reason === \'Calculation/Time Panic\') counts.timePanic++;\\n    else counts.unclassified++;\\n  });\\n\\n  return counts;\\n}\\n\", \"Description\":\"Spaced repetition calculations and Mistake Vault taxonomy filtering logic\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/srsVault.ts\", \"toolAction\":\"Writing SRS and mistake vault logic\", \"toolSummary\":\"Create src/utils/srsVault.ts\"}"
      thinking_signature: "\022\213\002\n\210\002\001i\024}\023\324\317\373F\310\257r\211Vp;\"\365\002\371Hz\251\364,/\365v\026\253%<#\0273\334\372\025\000d\266$\026\300,|\206\261\316_\253\237\352d\346^\350\rA\025\234g\224i\361\022\335\346\350\251\345\'S\215\235\214\252\244\334\251\r\277\340\353\245@\311\276\371<\227\315\266q\255e3\255}p\256\251\327\201\245\016WL\034\240\270w\n\347\006\tc=\315\267\2131\033^\307\001\374\375\005\021c\301\017\327\320b\332K{#\334\353\212\262AF+\0042\215\217\316v\246\'\026`\031\374S\267\025\004\336Y\210\267\017\203&:\215ff\236\271\316M\322\026\204\017\331v\252\265Z\310\373?\256~\315\235K\223\ruH\213\b\017\234\354\217\306k\254D\001\246YCq\034\221\235\0214\301*\220.\265h\321\377\252\343\370\340a-\371\024\261W-\r\222\253\344q\212\2309\371d\237\372\357\016\270\224\356\352\201\304\3756\221B\305x"
