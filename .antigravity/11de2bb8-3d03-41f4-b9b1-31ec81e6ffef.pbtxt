              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const solvedCount = solvedQuestionIds.length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const mistakeSet = new Set(mistakes.map(m => m.questionId));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // CAPF Questions"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const capfQuestions = questions.filter(q => q.targetExam.includes(\'UPSC_CAPF\'));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const capfSolved = capfQuestions.filter(q => solvedQuestionIds.includes(q.id));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const capfCorrect = capfSolved.filter(q => !mistakeSet.has(q.id)).length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const capfP1Accuracy = capfSolved.length > 0 ? (capfCorrect / capfSolved.length) * 100 : 40;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Paper 2 contribution"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const avgPaper2Score = submissions.length > 0 "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ? (submissions.reduce((acc, s) => acc + (s.aiFeedback?.totalScore || 10), 0) / submissions.length) * 5 "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    : 35; // Default baseline out of 100"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  "
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const capfScore = Math.min(100, Math.round((capfP1Accuracy * 0.6) + (avgPaper2Score * 0.3) + Math.min(10, (solvedCount / 20) * 10)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // CPO Questions"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cpoQuestions = questions.filter(q => q.targetExam.includes(\'SSC_CPO\'));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cpoSolved = cpoQuestions.filter(q => solvedQuestionIds.includes(q.id));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cpoCorrect = cpoSolved.filter(q => !mistakeSet.has(q.id)).length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cpoAccuracy = cpoSolved.length > 0 ? (cpoCorrect / cpoSolved.length) * 100 : 45;"
