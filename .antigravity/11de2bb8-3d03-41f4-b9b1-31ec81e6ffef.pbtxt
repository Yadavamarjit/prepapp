              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          questionText: `With reference to the constitutional machinery during emergencies in India, consider the following statements:`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          statements: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            \'During a National Emergency, the Centre becomes entitled to give executive directions to a state on \"any\" matter, not merely limited to federal list subjects.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            \'The life of the Lok Sabha may be extended by Parliament by law for any period not exceeding one year at a time during a National Emergency.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            \'A resolution of disapproval of National Emergency can be passed by the Lok Sabha alone with a simple majority.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            \'During President Rule under Article 356, the State Legislative Assembly is automatically dissolved upon the proclamation.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          options: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            { key: \'A\', text: \'1, 2 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            { key: \'B\', text: \'2, 3 and 4 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            { key: \'C\', text: \'1 and 2 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            { key: \'D\', text: \'1, 2, 3 and 4\' },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          correctAnswer: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          explanation: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            coreConcept:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              \'Statements 1, 2, and 3 are correct. Statement 4 is FALSE: S.R. Bommai judgment held that the Assembly should not be dissolved until Parliament approves the proclamation; it is only suspended initially.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            shortcutOrTrick:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              \'Elimination Clue: Statement 4 states \"automatically dissolved\", which violates S.R. Bommai doctrine. Eliminating Statement 4 discards B and D. Statement 3 (disapproval by Lok Sabha alone via simple majority under 44th Act) confirms Option A.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            standardBookRef: \'M. Laxmikanth Ch. 16 & Bommai Case Precedent\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            trapAlert: \'Approval needs both Houses by special majority; but Disapproval needs Lok Sabha alone by simple majority.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
