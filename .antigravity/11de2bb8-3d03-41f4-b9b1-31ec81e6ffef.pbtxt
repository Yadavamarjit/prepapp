  view_file {
    absolute_path_uri: "file:///src/components/AiTopicBreakdown.tsx"
    start_line: 834
    end_line: 914
    content: "            </div>\n          </div>\n\n          {/* Adaptive Question Generation Trigger Box */}\n          <div className=\"p-5 rounded-xl bg-gradient-to-r from-[#E3EFE8]/50 to-[#F2F4F0] dark:from-[#1A2E24] dark:to-[#121816] border border-[#36624B]/30 space-y-4\">\n            <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-[#36624B]/15\">\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h4 className=\"font-bold text-sm text-[#1E252B] dark:text-white\">\n                    Generate Practice Questions (Calibrated to Current Gap)\n                  </h4>\n                  <span className={`text-[10px] font-bold px-2 py-0.5 rounded ${\n                    isManualOverride ? \'bg-[#36624B] text-white\' : \'bg-[#E3EFE8] text-[#36624B]\'\n                  }`}>\n                    {effectiveAssessment.statementDepth === 1 ? \'1 Statement (Factual Recall)\' : `${effectiveAssessment.statementDepth} Statements`}\n                  </span>\n                </div>\n                <p className=\"text-xs text-[#5C646B] dark:text-slate-300 mt-1\">\n                  Engine will generate questions specifically addressing: <span className=\"font-semibold text-[#1E252B] dark:text-white\">\"{effectiveAssessment.identifiedGap}\"</span>\n                </p>\n              </div>\n\n              <button\n                onClick={handleGenerateQuestions}\n                disabled={isGeneratingQuestions}\n                className=\"px-5 py-2.5 rounded-lg bg-[#36624B] hover:bg-[#2A4F3C] text-white text-xs font-semibold shadow-sm flex items-center gap-2 whitespace-nowrap transition-all disabled:opacity-50\"\n              >\n                <Zap className=\"w-4 h-4 text-[#D97746]\" />\n                <span>\n                  {isGeneratingQuestions\n                    ? \'Calibrating Questions...\'\n                    : effectiveAssessment.statementDepth === 1\n                    ? \'Generate 1-Statement Drill\'\n                    : `Generate ${effectiveAssessment.statementDepth}-Statement Drill`}\n                </span>\n              </button>\n            </div>\n\n            {/* Statement Depth Configuration UI */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <span className=\"text-[11px] font-bold uppercase tracking-wider text-[#5C646B] dark:text-slate-400\">\n                  Select Statement Depth:\n                </span>\n                <span className=\"text-[10px] text-[#5C646B] dark:text-slate-400\">\n                  {effectiveAssessment.statementDepth === 1 && \'Single-statement direct factual recall (CBT objective format)\'}\n                  {effectiveAssessment.statementDepth === 2 && \'2-statement binary contrast & core concept reinforcement\'}\n                  {effectiveAssessment.statementDepth === 3 && \'3-statement canonical UPSC CAPF elimination\'}\n                  {effectiveAssessment.statementDepth === 4 && \'4-statement complex multi-layered constitutional analysis\'}\n                </span>\n              </div>\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n                {[\n                  { depth: 1, label: \'1 Stmt (Factual Recall)\', desc: \'Direct CBT Recall\' },\n                  { depth: 2, label: \'2 Stmts (Foundational)\', desc: \'Binary Contrast\' },\n                  { depth: 3, label: \'3 Stmts (Standard UPSC)\', desc: \'Standard Elimination\' },\n                  { depth: 4, label: \'4 Stmts (Complex Analysis)\', desc: \'Multi-Combinatorial\' },\n                ].map(({ depth, label, desc }) => {\n                  const isActive = effectiveAssessment.statementDepth === depth;\n                  return (\n                    <button\n                      key={depth}\n                      type=\"button\"\n                      onClick={() => {\n                        setIsManualOverride(true);\n                        setManualDepth(depth as 1 | 2 | 3 | 4);\n                      }}\n                      className={`p-2.5 rounded-lg border text-left transition-all cursor-pointer ${\n                        isActive\n                          ? \'bg-[#36624B] text-white border-[#36624B] shadow-sm\'\n                          : \'bg-[#FFFFFF] dark:bg-[#121816] text-[#1E252B] dark:text-slate-200 border-[#E2E6DD] dark:border-slate-800 hover:border-[#36624B]\'\n                      }`}\n                    >\n                      <div className=\"text-xs font-bold leading-tight\">{label}</div>\n                      <div className={`text-[10px] mt-0.5 ${isActive ? \'text-[#E3EFE8]\' : \'text-[#5C646B] dark:text-slate-400\'}`}>\n                        {desc}\n                      </div>\n                    </button>\n                  );\n                })}\n              </div>"
    num_lines: 1095
