        target_content: "  // Trigger Dynamic Practice Question Generation based on Learning Gap & Adaptive Depth\n  const handleGenerateQuestions = async () => {\n    if (!selectedTopic) return;\n    setIsGeneratingQuestions(true);\n\n    try {\n      const res = await fetch(\'/api/ai/generate-questions\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          topic: selectedTopic,\n          subject: selectedSubject,\n          examTrack: examTrackChoice === \'BOTH\' ? \'UPSC_CAPF\' : examTrackChoice,\n          specificGap: customGap || effectiveAssessment.identifiedGap,\n          count: 3,\n          adaptiveAssessment: effectiveAssessment,\n        }),\n      });\n\n      const data = await res.json();\n      if (!res.ok || !data.success) {\n        throw new Error(data.error || \'Failed to generate practice questions\');\n      }\n\n      setGeneratedQuestions(data.questions);\n      onAddQuestionsToBank(data.questions);\n      setUserDrillAnswers({});\n      setShowDrillSolutions({});\n    } catch (err: any) {\n      alert(`Question generation failed: ${err.message}`);\n    } finally {\n      setIsGeneratingQuestions(false);\n    }\n  };"
        replacement_content: "  // Trigger Dynamic Practice Question Generation based on Learning Gap & Adaptive Depth\n  const handleGenerateQuestions = async () => {\n    if (!selectedTopic) return;\n    setIsGeneratingQuestions(true);\n    setGenerationError(null);\n\n    try {\n      const res = await fetch(\'/api/ai/generate-questions\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          topic: selectedTopic,\n          subject: selectedSubject,\n          examTrack: examTrackChoice === \'BOTH\' ? \'UPSC_CAPF\' : examTrackChoice,\n          specificGap: customGap || effectiveAssessment.identifiedGap,\n          count: questionCount,\n          complexityTier: complexityTier,\n          statementDepth: manualDepth,\n          adaptiveAssessment: effectiveAssessment,\n        }),\n      });\n\n      const data = await res.json();\n      if (!res.ok || !data.success) {\n        throw new Error(data.error || \'Failed to generate practice questions\');\n      }\n\n      setGeneratedQuestions(data.questions);\n      onAddQuestionsToBank(data.questions);\n      setUserDrillAnswers({});\n      setShowDrillSolutions({});\n    } catch (err: any) {\n      setGenerationError(err.message || \'Question generation failed\');\n    } finally {\n      setIsGeneratingQuestions(false);\n    }\n  };"
        start_line: 159
        end_line: 192
