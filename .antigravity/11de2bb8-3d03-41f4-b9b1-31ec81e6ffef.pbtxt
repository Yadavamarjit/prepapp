            }
            lines {
              text: "2. UPSC Analytical Depth: Constitutional articles, historical acts, legal provisions, landmark Supreme Court cases, or border security mandates relevant for CAPF Paper 1 & 2."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "3. SSC CPO Speed Shortcut: Direct formula, 30-second mental trick, or rapid identification pattern."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "4. High-Yield Memory Hook / Mnemonic: An unforgettable memory aid."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "5. Common Examiner Trap: The subtle trap or wording trick examiners use to induce negative marking.`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const response = await ai.models.generateContent({"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      model: \'gemini-3.8-flash\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      contents: prompt,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      config: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        systemInstruction,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        responseMimeType: \'application/json\',"
