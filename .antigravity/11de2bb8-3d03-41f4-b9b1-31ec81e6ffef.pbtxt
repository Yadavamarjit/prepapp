              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const diagnosedGap = adaptiveAssessment?.identifiedGap || specificGap || \'Reinforce core principles\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  try {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const systemInstruction = `You are a senior question setter for UPSC CAPF AC and SSC CPO."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "CRITICAL ADAPTIVE CALIBRATION DIRECTIVE:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Complexity Level: ${complexityLevel.toUpperCase()}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Statement Depth: EXACTLY ${statementDepth} numbered statements per UPSC multi-statement question."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Diagnosed Learning Gap to Target: \"${diagnosedGap}\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- Trap Directive: Inject \"${targetTrap}\" traps to train aspirant\'s weaknesses."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Rules per statement depth:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "${"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  statementDepth === 1"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ? `- FACTUAL RECALL LEVEL: Provide EXACTLY 1 direct single-statement objective question (Direct CBT format)."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
