  code_action {
    action_spec {
      create_file {
        instruction: "import express from \'express\';\nimport dotenv from \'dotenv\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst app = express();\nconst PORT = process.env.PORT || 3000;\n\napp.use(express.json({ limit: \'10mb\' }));\n\n// Server-side initialization of Google GenAI SDK\nconst ai = new GoogleGenAI({\n  apiKey: process.env.GEMINI_API_KEY,\n  httpOptions: {\n    headers: {\n      \'User-Agent\': \'aistudio-build\',\n    },\n  },\n});\n\n// 1. AI Syllabus Tutor: \"Break Topic Down Easy\"\napp.post(\'/api/ai/breakdown\', async (req, res) => {\n  try {\n    const { topic, subject, standardRef, examFocus } = req.body;\n\n    if (!topic) {\n      return res.status(400).json({ error: \'Topic is required\' });\n    }\n\n    const systemInstruction = `You are a legendary UPSC CAPF AC and SSC CPO mentor who excels at deconstructing complex military, constitutional, quantitative, and historical topics into crystal-clear, high-retention mental frameworks.\nTeach in an intuitive, accessible style (\"teach very easy\") while retaining the rigorous academic depth required for UPSC CAPF Paper 1 & 2 and the speed precision required for SSC CPO.`;\n\n    const prompt = `Break down the following exam topic for an aspirant preparing simultaneously for UPSC CAPF AC and SSC CPO:\nTopic: \"${topic}\"\nSubject: \"${subject || \'General Studies\'}\"\nStandard Book Reference: \"${standardRef || \'Standard NCERT / Laxmikanth / Spectrum\'}\"\nTarget Exam Focus: \"${(examFocus || [\'CAPF\', \'CPO\']).join(\', \')}\"\n\nProvide a structured breakdown containing:\n1. Core Intuition / ELI5: 3 clear, punchy bullet points explaining the core concept in plain English.\n2. UPSC Analytical Depth: Constitutional articles, historical acts, legal provisions, landmark Supreme Court cases, or border security mandates relevant for CAPF Paper 1 & 2.\n3. SSC CPO Speed Shortcut: Direct formula, 30-second mental trick, or rapid identification pattern.\n4. High-Yield Memory Hook / Mnemonic: An unforgettable memory aid.\n5. Common Examiner Trap: The subtle trap or wording trick examiners use to induce negative marking.`;\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.8-flash\',\n      contents: prompt,\n      config: {\n        systemInstruction,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            topic: { type: Type.STRING },\n            eli5Summary: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \'3 clear, simple bullet points explaining the concept easily\',\n            },\n            upscAnalyticalDepth: {\n              type: Type.STRING,\n              description: \'Constitutional, legal, and operational analysis for UPSC CAPF\',\n            },\n            cpoSpeedShortcut: {\n              type: Type.STRING,\n              description: \'Speed formula or 30s shortcut for SSC CPO\',\n            },\n            memoryHook: {\n              type: Type.STRING,\n              description: \'High-yield mnemonic or memory device\',\n            },\n            examinerTrap: {\n              type: Type.STRING,\n              description: \'Classic negative-marking pitfall or distractor trap\',\n            },\n            recommendedChapters: {\n              type: Type.STRING,\n              description: \'Exact book chapter and reading priority\',\n            },\n          },\n          required: [\n            \'topic\',\n            \'eli5Summary\',\n            \'upscAnalyticalDepth\',\n            \'cpoSpeedShortcut\',\n            \'memoryHook\',\n            \'examinerTrap\',\n          ],\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'{}\');\n    return res.json({ success: true, data: parsed });\n  } catch (error: any) {\n    console.error(\'Error generating topic breakdown:\', error);\n    return res.status(500).json({\n      error: \'Failed to break down topic with AI\',\n      details: error?.message || String(error),\n    });\n  }\n});\n\n// 2. AI Question Generator: Personalized practice questions for learning gaps\napp.post(\'/api/ai/generate-questions\', async (req, res) => {\n  try {\n    const { topic, subject, examTrack, specificGap, count = 3 } = req.body;\n\n    const requestedCount = Math.min(Math.max(1, Number(count) || 3), 5);\n    const track = examTrack || \'UPSC_CAPF\';\n\n    const systemInstruction = `You are a senior question setter for UPSC CAPF AC (Assistant Commandant) and SSC CPO (Sub-Inspector).\nWhen setting UPSC CAPF questions:\n- Use authentic UPSC multi-statement format (\"Consider the following statements... Which of the statements given above is/are correct? 1 only, 1 and 2 only, etc.\").\n- Ensure questions test constitutional nuances, historical precision, or border geography.\n- Provide a rigorous explanation containing coreConcept, shortcutOrTrick (how to eliminate options using logic), and standardBookRef (e.g. Laxmikanth Ch. X).\n\nWhen setting SSC CPO questions:\n- Use high-speed CBT format with 4 options (A, B, C, D).\n- For Quant/Reasoning, include 30-second formula shortcuts in shortcutOrTrick.`;\n\n    const prompt = `Generate ${requestedCount} practice questions for:\nTopic: \"${topic}\"\nSubject: \"${subject || \'General Studies\'}\"\nTarget Exam Track: \"${track}\"\nAspirant Specific Learning Gap to address: \"${specificGap || \'Reinforce core principles and avoid common distractors\'}\"\n\nGenerate clean, authentic questions matching real exam papers.`;\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.8-flash\',\n      contents: prompt,\n      config: {\n        systemInstruction,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.ARRAY,\n          items: {\n            type: Type.OBJECT,\n            properties: {\n              id: { type: Type.STRING },\n              targetExam: {\n                type: Type.ARRAY,\n                items: { type: Type.STRING },\n              },\n              subject: { type: Type.STRING },\n              microTopic: { type: Type.STRING },\n              difficulty: { type: Type.STRING, enum: [\'Speed\', \'Analytical\'] },\n              type: { type: Type.STRING, enum: [\'SINGLE_CHOICE\', \'STATEMENT_BASED\'] },\n              questionText: { type: Type.STRING },\n              statements: {\n                type: Type.ARRAY,\n                items: { type: Type.STRING },\n                description: \'Numbered statements (1, 2, 3) for UPSC multi-statement questions\',\n              },\n              options: {\n                type: Type.ARRAY,\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    key: { type: Type.STRING, enum: [\'A\', \'B\', \'C\', \'D\'] },\n                    text: { type: Type.STRING },\n                  },\n                  required: [\'key\', \'text\'],\n                },\n              },\n              correctAnswer: { type: Type.STRING, enum: [\'A\', \'B\', \'C\', \'D\'] },\n              explanation: {\n                type: Type.OBJECT,\n                properties: {\n                  coreConcept: { type: Type.STRING },\n                  shortcutOrTrick: { type: Type.STRING },\n                  standardBookRef: { type: Type.STRING },\n                  trapAlert: { type: Type.STRING },\n                },\n                required: [\'coreConcept\'],\n              },\n              yearRef: { type: Type.STRING },\n            },\n            required: [\n              \'id\',\n              \'targetExam\',\n              \'subject\',\n              \'microTopic\',\n              \'difficulty\',\n              \'type\',\n              \'questionText\',\n              \'options\',\n              \'correctAnswer\',\n              \'explanation\',\n            ],\n          },\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'[]\');\n    // Ensure unique IDs\n    const questionsWithIds = parsed.map((q: any, i: number) => ({\n      ...q,\n      id: q.id || `gen-${Date.now()}-${i}`,\n      yearRef: q.yearRef || \'AI Adaptive Drill\',\n    }));\n\n    return res.json({ success: true, questions: questionsWithIds });\n  } catch (error: any) {\n    console.error(\'Error generating AI questions:\', error);\n    return res.status(500).json({\n      error: \'Failed to generate personalized questions\',\n      details: error?.message || String(error),\n    });\n  }\n});\n\n// 3. UPSC CAPF Paper 2 Subjective Evaluation API\napp.post(\'/api/ai/evaluate-paper2\', async (req, res) => {\n  try {\n    const { topicType, prompt: questionPrompt, content, wordCount, originalPassage } = req.body;\n\n    if (!content || content.trim().length < 20) {\n      return res.status(400).json({ error: \'Please write substantive content before evaluating.\' });\n    }\n\n    const systemInstruction = `You are an official UPSC CAPF Paper 2 evaluator following the strict Union Public Service Commission grading criteria for Assistant Commandant examination.\nEvaluate the candidate\'s answer strictly out of 20 marks based on:\n1. Structural integrity (Header/Intro -> Arguments For -> Arguments Against -> Conclusion).\n2. Factual & constitutional depth (accuracy of MHA mandates, border geography, articles, committees).\n3. Tone and objectivity (strict zero tolerance for emotional or politically biased partisan rhetoric; must be balanced and administrative).\n4. Pr\303\251cis rule adherence (if type is PRECIS, must enforce 1/3 word count and independent synthesis).`;\n\n    const userMessage = `Evaluate this candidate submission for UPSC CAPF Paper 2:\nQuestion Type: ${topicType}\nQuestion Prompt: \"${questionPrompt}\"\nCandidate Word Count: ${wordCount}\n${originalPassage ? `Original Pr\303\251cis Passage:\\n\"\"\"\\n${originalPassage}\\n\"\"\"\\n` : \'\'}\n\nCandidate Submission Content:\n\"\"\"\n${content}\n\"\"\"\n\nProvide a detailed evaluation JSON adhering to UPSC standards.`;\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.8-flash\',\n      contents: userMessage,\n      config: {\n        systemInstruction,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            totalScore: { type: Type.NUMBER, description: \'Total marks awarded out of 20\' },\n            structuralScore: { type: Type.NUMBER, description: \'Score out of 6 for layout & structure\' },\n            factualAndDepthScore: { type: Type.NUMBER, description: \'Score out of 8 for constitutional/factual depth\' },\n            toneAndGrammarScore: { type: Type.NUMBER, description: \'Score out of 6 for neutral tone & diction\' },\n            objectiveToneAudit: {\n              type: Type.STRING,\n              description: \'Critique of emotional vs balanced administrative tone\',\n            },\n            pointsForFeedback: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \'Feedback on arguments in favor (strength, relevance)\',\n            },\n            pointsAgainstFeedback: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n              description: \'Feedback on counter-arguments against (depth, counter-points)\',\n            },\n            pr\303\251cisRuleCompliance: {\n              type: Type.STRING,\n              description: \'Assessment of word limit and title compliance if Precis\',\n            },\n            strengths: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n            },\n            suggestedImprovements: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n            },\n            modelAnswerSnippet: {\n              type: Type.STRING,\n              description: \'A model improved paragraph showcasing ideal UPSC structure and tone\',\n            },\n          },\n          required: [\n            \'totalScore\',\n            \'structuralScore\',\n            \'factualAndDepthScore\',\n            \'toneAndGrammarScore\',\n            \'objectiveToneAudit\',\n            \'pointsForFeedback\',\n            \'pointsAgainstFeedback\',\n            \'strengths\',\n            \'suggestedImprovements\',\n            \'modelAnswerSnippet\',\n          ],\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'{}\');\n    return res.json({ success: true, feedback: parsed });\n  } catch (error: any) {\n    console.error(\'Error evaluating Paper 2 submission:\', error);\n    return res.status(500).json({\n      error: \'Failed to evaluate Paper 2 submission\',\n      details: error?.message || String(error),\n    });\n  }\n});\n\n// 4. AI Mistake Diagnostic: Explaining the exact distractor trap\napp.post(\'/api/ai/diagnose-mistake\', async (req, res) => {\n  try {\n    const { question, selectedAnswer, reason } = req.body;\n\n    const prompt = `A student preparing for UPSC CAPF / SSC CPO attempted this question and made a mistake.\nQuestion Text: \"${question.questionText}\"\nStatements: ${JSON.stringify(question.statements || [])}\nCorrect Answer: ${question.correctAnswer} (${question.options?.find((o: any) => o.key === question.correctAnswer)?.text})\nStudent Selected Answer: ${selectedAnswer} (${question.options?.find((o: any) => o.key === selectedAnswer)?.text})\nStudent Stated Reason: \"${reason}\"\nCore Concept: \"${question.explanation?.coreConcept}\"\n\nProvide:\n1. Why this option is a classic psychological trap designed by examiners.\n2. The exact 1-minute mental rule to never make this mistake again in the CBT examination.`;\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.8-flash\',\n      contents: prompt,\n      config: {\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            trapAnalysis: { type: Type.STRING },\n            preventionRule: { type: Type.STRING },\n            recommendedRevisionNote: { type: Type.STRING },\n          },\n          required: [\'trapAnalysis\', \'preventionRule\', \'recommendedRevisionNote\'],\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'{}\');\n    return res.json({ success: true, diagnosis: parsed });\n  } catch (error: any) {\n    console.error(\'Error diagnosing mistake:\', error);\n    return res.status(500).json({\n      error: \'Failed to diagnose mistake\',\n      details: error?.message || String(error),\n    });\n  }\n});\n\n// Vite middleware for development or static serving for production\nasync function startServer() {\n  if (process.env.NODE_ENV !== \'production\') {\n    const { createServer: createViteServer } = await import(\'vite\');\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    app.use(express.static(path.resolve(__dirname, \'dist\')));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.resolve(__dirname, \'dist\', \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, () => {\n    console.log(`DutyDeck Full-Stack Server running on port ${PORT}`);\n  });\n}\n\nstartServer();\n"
        path {
