            }
            lines {
              text: "      \'Article 33 empowers both the Parliament and State Legislatures to restrict the Fundamental Rights of members of the Armed Forces and Police forces.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A law enacted by Parliament under Article 33 cannot be challenged in any court on the ground of contravention of any Fundamental Right.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Martial Law under Article 34 affects only Fundamental Rights, whereas National Emergency under Article 352 affects not only Fundamental Rights but also Centre-State relations.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'A\', text: \'1 and 2 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'B\', text: \'2 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'C\', text: \'3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'D\', text: \'1, 2 and 3\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctAnswer: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      coreConcept: \'Article 33 gives power solely to Parliament (not State Legislatures) to restrict or abrogate fundamental rights of armed forces, police forces, and intelligence agencies.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      shortcutOrTrick: \'Eliminate Statement 1 because State Legislatures have zero jurisdiction under Art 33. This eliminates A and D instantly. Statement 2 and 3 are standard constitutional tenets.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      standardBookRef: \'M. Laxmikanth \342\200\224 Chapter 7: Fundamental Rights (Articles 33 & 34)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      trapAlert: \'UPSC frequently slips \"and State Legislatures\" into Parliament-exclusive powers (Art 33, Art 35, Art 368).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    yearRef: \'UPSC CAPF AC 2021\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'capf-pol-03\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetExam: [\'UPSC_CAPF\', \'SSC_CPO\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Polity & Constitution\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    microTopic: \'Preamble & Amendments\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    difficulty: \'Analytical\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    type: \'STATEMENT_BASED\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    questionText: \'Which of the following statements regarding the Preamble to the Constitution of India is/are correct?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    statements: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The Preamble is neither a source of power to the legislature nor a prohibition upon the powers of the legislature.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'It is justiciable, and its provisions can be enforced in courts of law.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The words \"Socialist\", \"Secular\", and \"Integrity\" were incorporated into the Preamble by the 44th Constitutional Amendment Act, 1978.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'A\', text: \'1 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'B\', text: \'1 and 2 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'C\', text: \'2 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'D\', text: \'1 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctAnswer: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      coreConcept: \'The Preamble is non-justiciable (Berubari & Kesavananda Bharati). The three words were added by the 42nd Amendment Act 1976, not the 44th.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      shortcutOrTrick: \'Statement 2 is false (non-justiciable). Statement 3 is false (42nd Amendment). Thus only Statement 1 is correct.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      standardBookRef: \'M. Laxmikanth \342\200\224 Chapter 4: Preamble of the Constitution\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      trapAlert: \'Remember 42nd Amendment (1976) introduced mini-constitution changes, while 44th (1978) restored civil liberties.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    yearRef: \'Shared Core PYQ\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // --- MODERN HISTORY (CAPF & CPO CORE) ---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'capf-hist-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetExam: [\'UPSC_CAPF\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Modern History\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    microTopic: \'1919-1935 Constitutional Reforms\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    difficulty: \'Analytical\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    type: \'STATEMENT_BASED\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    questionText: \'Consider the following statements regarding the Government of India Act, 1919 (Montagu-Chelmsford Reforms):\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    statements: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'It introduced dyarchy in the executive government of the provinces.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'It introduced, for the first time, bicameralism and direct elections in the country at the central legislature.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'It extended the principle of communal representation by providing separate electorates for Sikhs, Indian Christians, Anglo-Indians, and Europeans.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'A\', text: \'1 and 2 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'B\', text: \'2 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'C\', text: \'1 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'D\', text: \'1, 2 and 3\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctAnswer: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      coreConcept: \'All three statements are historically accurate: Dyarchy in provinces (transferred and reserved subjects), bicameral central legislature (Council of State & Legislative Assembly), and extension of separate electorates beyond Muslims (1909) to Sikhs, Christians, Anglo-Indians, and Europeans in 1919.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      shortcutOrTrick: \'Mnemonic: 1919 introduced Provincial Dyarchy (1935 abolished it and brought Provincial Autonomy while introducing Central Dyarchy).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      standardBookRef: \'Spectrum Modern India (Rajiv Ahir) \342\200\224 Chapter 16: Nationalist Upsurge & 1919 Act\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      trapAlert: \'Watch out for questions mixing 1919 (Provincial Dyarchy) with 1935 (Provincial Autonomy).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    yearRef: \'UPSC CAPF AC 2020\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'cpo-hist-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetExam: [\'SSC_CPO\', \'UPSC_CAPF\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Modern History\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    microTopic: \'Socio-Religious Movements\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    difficulty: \'Speed\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    type: \'SINGLE_CHOICE\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    questionText: \'Who among the following founded the \"Satyashodhak Samaj\" in 1873 to campaign against the caste system and promote education among women and lower castes?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'A\', text: \'Gopal Hari Deshmukh (Lokahitawadi)\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'B\', text: \'Jyotirao Govindrao Phule\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'C\', text: \'Mahadev Govind Ranade\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'D\', text: \'B. R. Ambedkar\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctAnswer: \'B\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      coreConcept: \'Jyotirao Phule established Satyashodhak Samaj (Truth Seekers Society) in Pune in 1873, authored Gulamgiri (1873), and started pioneering schools for girls with his wife Savitribai Phule.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      shortcutOrTrick: \'Direct recall: Satyashodhak = Jyotirao Phule (Gulamgiri). Ambedkar established Bahishkrit Hitakarini Sabha (1924).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      standardBookRef: \'Spectrum Modern India \342\200\224 Chapter 9: Socio-Religious Reform Movements\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    yearRef: \'SSC CPO 2023 Tier-1\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // --- GEOGRAPHY & ENVIRONMENT ---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'capf-geo-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetExam: [\'UPSC_CAPF\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Geography & Environment\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    microTopic: \'Physiography of Peninsular India\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    difficulty: \'Analytical\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    type: \'STATEMENT_BASED\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    questionText: \'With reference to the Western Ghats and Eastern Ghats, consider the following statements:\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    statements: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The Western Ghats are comparatively higher in elevation and more continuous than the Eastern Ghats.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'The Eastern Ghats are dissected and irregular because of major rivers draining into the Bay of Bengal.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Anamudi, the highest peak of the Peninsular plateau, is situated in the Eastern Ghats.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'A\', text: \'1 and 2 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'B\', text: \'2 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'C\', text: \'1 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'D\', text: \'1, 2 and 3\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctAnswer: \'A\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      coreConcept: \'Anamudi (2,695 m) is the highest peak of peninsular India and is located on the Anaimalai Hills in the Western Ghats (Kerala), not Eastern Ghats.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      shortcutOrTrick: \'Elimination: Statement 3 is definitely false (Anamudi is in Western Ghats). Cross out B, C, D! Answer A is found in under 15 seconds.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      standardBookRef: \'NCERT Class 11 India: Physical Environment \342\200\224 Chapter 2: Structure and Physiography\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      trapAlert: \'Highest peak of Eastern Ghats is Jindhagada Peak / Mahendragiri, while Anamudi and Dodabetta are Western Ghats / Nilgiris.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    yearRef: \'UPSC CAPF AC 2023\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // --- GENERAL SCIENCE ---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'capf-sci-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetExam: [\'UPSC_CAPF\', \'SSC_CPO\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'General Science\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    microTopic: \'Optics & Total Internal Reflection\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    difficulty: \'Analytical\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    type: \'STATEMENT_BASED\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    questionText: \'Which of the following optical phenomena are governed by the principle of Total Internal Reflection (TIR)?\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    statements: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Working of optical fibre cables in telecommunication.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Formation of mirage in desert regions on hot summer days.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Sparkling of properly cut diamond facets.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'A\', text: \'1 and 2 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'B\', text: \'2 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'C\', text: \'1 and 3 only\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'D\', text: \'1, 2 and 3\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    correctAnswer: \'D\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    explanation: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      coreConcept: \'Total Internal Reflection occurs when light travels from denser to rarer medium and angle of incidence exceeds critical angle. Optical fiber, mirage, and diamond brilliance all rely on TIR.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      shortcutOrTrick: \'All three are textbook applications of TIR in Class 10 & 12 NCERT Physics.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      standardBookRef: \'NCERT Class 10 Chapter 10 / Class 12 Ray Optics\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    yearRef: \'Shared Core Science\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // --- QUANTITATIVE APTITUDE (CPO SPRINT SPECIAL) ---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'cpo-quant-01\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    targetExam: [\'SSC_CPO\'],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    subject: \'Quantitative Aptitude\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    microTopic: \'Compound & Simple Interest Difference\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    difficulty: \'Speed\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    type: \'SINGLE_CHOICE\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    questionText: \'The difference between compound interest (compounded annually) and simple interest on a sum of \342\202\27115,000 for 2 years is \342\202\27196. Find the rate of interest per annum.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    options: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'A\', text: \'6%\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      { key: \'B\', text: \'8%\' },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
