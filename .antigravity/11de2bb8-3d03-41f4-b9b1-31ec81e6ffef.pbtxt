    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "11de2bb8-3d03-41f4-b9b1-31ec81e6ffef"
      step_index: 1
      cascade_id: "11de2bb8-3d03-41f4-b9b1-31ec81e6ffef"
