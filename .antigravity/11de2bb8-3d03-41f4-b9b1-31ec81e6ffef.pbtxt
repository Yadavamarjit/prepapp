            }
            lines {
              text: "// 2. AI Question Generator: Personalized practice questions for learning gaps"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "app.post(\'/api/ai/generate-questions\', async (req, res) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const { topic, subject, examTrack, specificGap, count = 3, adaptiveAssessment } = req.body;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const requestedCount = Math.min(Math.max(1, Number(count) || 3), 5);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const track = examTrack || \'UPSC_CAPF\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const statementDepth = adaptiveAssessment?.statementDepth || 3;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const complexityLevel = adaptiveAssessment?.level || \'Standard\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const targetTrap = adaptiveAssessment?.trapTypeToInject || \'None\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const diagnosedGap = adaptiveAssessment?.identifiedGap || specificGap || \'Reinforce core principles\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  try {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const systemInstruction = `You are a senior question setter for UPSC CAPF AC and SSC CPO."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
