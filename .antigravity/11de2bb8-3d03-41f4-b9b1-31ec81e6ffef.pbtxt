    content: "              )}\n            </div>\n          </div>\n\n          {/* Tile 2: Statement Depth Tuning */}\n          <div className=\"p-3 rounded-lg bg-[#FFFFFF] dark:bg-[#121816] border border-[#EEF0EA] dark:border-slate-800\">\n            <div className=\"flex justify-between items-center\">\n              <span className=\"text-[10px] uppercase font-bold text-[#5C646B] tracking-wider\">\n                Statement Depth\n              </span>\n              <span className=\"text-[10px] font-bold px-1.5 py-0.2 rounded bg-[#E3EFE8] text-[#36624B]\">\n                {effectiveAssessment.statementDepth} Stmts\n              </span>\n            </div>\n            \n            {/* Visual statement depth bar */}\n            <div className=\"mt-2 grid grid-cols-3 gap-1.5 text-center\">\n              {[2, 3, 4].map((depth) => {\n                const isActive = effectiveAssessment.statementDepth === depth;\n                return (\n                  <button\n                    key={depth}\n                    type=\"button\"\n                    disabled={!isManualOverride}\n                    onClick={() => setManualDepth(depth as 2 | 3 | 4)}\n                    className={`py-1 rounded text-[11px] font-bold border transition-all ${\n                      isActive\n                        ? \'bg-[#36624B] text-white border-[#36624B] shadow-xs\'\n                        : \'bg-[#F7F8F5] dark:bg-slate-900 text-[#5C646B] border-[#EEF0EA]\'\n                    } ${isManualOverride ? \'cursor-pointer hover:border-[#36624B]\' : \'cursor-default\'}`}\n                  >\n                    {depth} Stmt{depth > 2 ? \'s\' : \'\'}\n                  </button>\n                );\n              })}\n            </div>\n            <div className=\"mt-1 text-[10px] text-[#5C646B] truncate\">\n              {effectiveAssessment.statementDepth === 2 && \'Remedial / Binary contrast\'}\n              {effectiveAssessment.statementDepth === 3 && \'Standard UPSC elimination\'}\n              {effectiveAssessment.statementDepth === 4 && \'Advanced multi-combinatorial\'}\n            </div>\n          </div>\n\n          {/* Tile 3: Diagnosed Learning Gap */}\n          <div className=\"p-3 rounded-lg bg-[#FFFFFF] dark:bg-[#121816] border border-[#EEF0EA] dark:border-slate-800\">\n            <span className=\"text-[10px] uppercase font-bold text-[#5C646B] tracking-wider block\">"
