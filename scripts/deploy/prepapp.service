[Unit]
Description=DutyDeck backend API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=prepapp
Group=prepapp
WorkingDirectory=/opt/prepapp/current
EnvironmentFile=/etc/prepapp/backend.env
ExecStart=/usr/local/bin/node --max-old-space-size=96 /opt/prepapp/current/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/prepapp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=48
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
