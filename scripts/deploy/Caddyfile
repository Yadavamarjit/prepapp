api-152-67-15-185.sslip.io {
    encode zstd gzip
    request_body {
        max_size 256KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:3000 {
            transport http {
                response_header_timeout 120s
            }
        }
    }
    handle {
        respond "Not found" 404
    }
}
