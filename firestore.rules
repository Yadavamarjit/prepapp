rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Validation Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'streakDays', 'solvedCount', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('streakDays' in data) || (data.streakDays is number)) &&
             (!('solvedCount' in data) || (data.solvedCount is number));
    }

    function isValidMistake(data) {
      return data.keys().hasAll(['id', 'questionId', 'selectedAnswer', 'correctAnswer', 'reason', 'timestamp', 'reviewCount', 'nextReviewDate']) &&
             data.id is string && data.id.size() <= 128 &&
             data.questionId is string && data.questionId.size() <= 128 &&
             data.selectedAnswer in ['A', 'B', 'C', 'D'] &&
             data.correctAnswer in ['A', 'B', 'C', 'D'] &&
             data.reason in ['Conceptual Gap', 'Misread Question', 'Calculation/Time Panic'] &&
             data.timestamp is number &&
             data.reviewCount is number &&
             data.nextReviewDate is number;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['id', 'userId', 'topicType', 'prompt', 'content', 'wordCount', 'submittedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.topicType in ['ESSAY', 'ARGUMENT', 'REPORT', 'PRECIS'] &&
             data.prompt is string && data.prompt.size() <= 500 &&
             data.content is string && data.content.size() <= 10000 &&
             data.wordCount is number &&
             data.submittedAt is number;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && incoming().uid == existing().uid && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // User Mistakes Subcollection
      match /mistakes/{mistakeId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(mistakeId) && isValidMistake(incoming());
        allow update: if isOwner(userId) && isValidId(mistakeId) && isValidMistake(incoming());
        allow delete: if isOwner(userId) && isValidId(mistakeId);
      }

      // User Submissions Subcollection
      match /submissions/{submissionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(submissionId) && isValidSubmission(incoming());
        allow update: if isOwner(userId) && isValidId(submissionId) && isValidSubmission(incoming());
        allow delete: if isOwner(userId) && isValidId(submissionId);
      }
    }
  }
}
